# Mercai Mobile E2E (Appium) — copy to .env

# ── Appium server ──────────────────────────────────────────────────
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# ── Device ─────────────────────────────────────────────────────────
DEVICE_NAME=Pixel_3a_API_36
UDID=emulator-5554
PLATFORM_VERSION=14

# ── App ────────────────────────────────────────────────────────────
APP_PACKAGE=com.mercai.app
APP_ACTIVITY=.MainActivity
# Expo is a MANAGED workflow, so there is no APK until:
#   cd front_end && npx expo prebuild -p android
#   cd android && ./gradlew assembleDebug
APK_PATH=

# ── Backend ────────────────────────────────────────────────────────
# The published tunnel. A device cannot reach the host's localhost, so do not
# point this at 127.0.0.1 unless the app runs on this machine.
# The URL the TEST PROCESS uses for seeding and API checks. It does NOT
# repoint the app -- the APK's backend is baked in at build time by
# front_end/src/constants/config.js. If the two disagree, the suite seeds one
# backend while the app reads another, which looks exactly like a failed seed.
BACKEND_URL=https://mercai.tuan1970.com

# Seeded seller from back_end/scripts/seed_catalogue.py. Owns products, so the
# price-intelligence tests need it -- but it exists ONLY where that seed has
# been run, NOT on the production deployment.
SELLER_USERNAME=gomthuha
SELLER_PASSWORD=MercaiTest@2026

# Accounts for the auth and product suites. These are created automatically by
# the `test_accounts` fixture if they are missing, so a rebuilt database needs
# no manual setup. Override only if the accounts already exist with different
# passwords -- that is the one case bootstrapping cannot repair.
AUTH_CUSTOMER_USERNAME=e2e_customer
AUTH_CUSTOMER_PASSWORD=E2eTest@2026
AUTH_SELLER_USERNAME=e2e_seller
AUTH_SELLER_PASSWORD=E2eTest@2026

# Prefix for users left behind by the registration tests, which have no
# delete-account path: DELETE FROM users WHERE username LIKE 'e2e_tmp_%';
THROWAWAY_PREFIX=e2e_tmp
