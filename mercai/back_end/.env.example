# =============================================================================
# MERCAI - ENVIRONMENT CONFIGURATION
# =============================================================================
#
#   cp .env.example .env
#
# Every value below matches the working deployment EXCEPT SECRET_KEY, which is
# a placeholder on purpose. This file is committed to git, so a real signing key
# here would be published to GitHub the moment anyone pushed.
#
# So after copying, do exactly one thing:
#
#   sed -i "s|^SECRET_KEY=.*|SECRET_KEY=$(openssl rand -hex 32)|" .env
#
# Everything else works as-is for a Docker deployment.
#
# Note on the database passwords: they are not blanked, because they are
# already the defaults committed in docker-compose.yml -- hiding them here
# would imply a secrecy that does not exist. They SHOULD be rotated before
# there is real data; see DEPLOYMENT_CLOUDFLARE.md.
# =============================================================================

# -----------------------------------------------------------------------------
# A note on the settings below that do nothing.
#
# ALLOWED_ORIGINS, API_BASE_URL, API_PORT, FRONTEND_URL, MAX_UPLOAD_SIZE,
# SMTP_USE_TLS and the four DB_POOL_* values are read by NOTHING in this repo --
# checked against shared/config.py, docker-compose.yml, every .py and .yml under
# back_end/, and deploy-interactive.sh. They are left in place rather than
# deleted because removing settings someone may be relying on elsewhere is a
# worse mistake than leaving them, but do not expect changing them to have any
# effect. CORS is currently hard-coded to allow_origins=["*"] in each service's
# main.py, and the connection pool uses SQLAlchemy's defaults.
# -----------------------------------------------------------------------------

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
ENVIRONMENT=production
DEBUG=false

# =============================================================================
# DATABASE CONFIGURATION - MySQL
# =============================================================================
#
# IMPORTANT: Understanding DB_HOST values
# ----------------------------------------
#
# Your server may have TWO MySQL instances:
#   1. Host MySQL    - Running directly on your server (port 3306)
#   2. Docker MySQL  - Running inside Docker container (mercai_mysql)
#
# ┌─────────────────────────────────────────────────────────────────────┐
# │                     YOUR SERVER (Host Machine)                       │
# │                                                                      │
# │  ┌────────────────────────────────────────┐                         │
# │  │         HOST MYSQL (Local)             │  ← Running directly     │
# │  │         Port: 3306                     │    on your server       │
# │  │         (NOT used by this app)         │                         │
# │  └────────────────────────────────────────┘                         │
# │                                                                      │
# │  ┌──────────────────────────────────────────────────────────────┐   │
# │  │                    DOCKER ENVIRONMENT                         │   │
# │  │                                                               │   │
# │  │  ┌─────────────────────┐    ┌─────────────────────────────┐  │   │
# │  │  │  mercai_mysql      │◄───│  Your App Services          │  │   │
# │  │  │  (Docker MySQL)     │    │  (auth, product, order...)  │  │   │
# │  │  │  Service name: "db" │    └─────────────────────────────┘  │   │
# │  │  └─────────────────────┘                                      │   │
# │  │           ▲                                                   │   │
# │  │           │ Docker Internal Network                           │   │
# │  │           │ Use "db" to connect (NOT localhost!)              │   │
# │  └──────────────────────────────────────────────────────────────┘   │
# └─────────────────────────────────────────────────────────────────────┘
#
# DB_HOST values:
#   - "db"                   → Docker MySQL container (CORRECT for Docker deployment)
#   - "host.docker.internal" → Host machine's MySQL (WRONG - different database!)
#   - "localhost"            → Host machine's MySQL (WRONG - different database!)
#
# ALWAYS use DB_HOST=db for Docker deployment!
#
DB_HOST=db
DB_PORT=3306
DB_NAME=mercai
DB_USER=mercai_user
DB_PASSWORD=Mysql_2025
# (the root password lives further down as MYSQL_ROOT_PASSWORD, which is the
#  name docker-compose.yml actually reads -- DB_ROOT_PASSWORD was read by
#  nothing and has been removed)

# External port for database access from host machine (for debugging)
# Connect from your machine: mysql -h localhost -P 3308 -u mercai_user -p
MERCAI_DB_PORT=3308

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# For Docker deployment: use container name "redis"
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_PORT=8002
API_BASE_URL=http://localhost:8002
FRONTEND_URL=http://localhost:3000

# CORS Configuration (comma-separated origins or * for all)
ALLOWED_ORIGINS=*

# Upload Configuration (bytes) - 10MB default
MAX_UPLOAD_SIZE=10485760

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# IMPORTANT: Change this in production!
# Generate secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CHANGE THIS. Generate with:  openssl rand -hex 32
# Leaving the placeholder means every deployment shares a signing key, so a
# token minted anywhere is valid everywhere.
SECRET_KEY=REPLACE_ME_WITH_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@mercai.com
SMTP_FROM_NAME=Mercai
SMTP_USE_TLS=true

# =============================================================================
# MICROSERVICES CONFIGURATION
# =============================================================================
# MySQL root password for docker-compose (used during container initialization)
MYSQL_ROOT_PASSWORD=Mysql_2025

# =============================================================================
# QUICK START
# =============================================================================
# 1. Copy this file:     cp .env.example .env
# 2. (Optional) Edit .env with your production values
# 3. Start services:     docker compose up -d
# 4. Check status:       docker compose ps
# 5. View logs:          docker compose logs -f
#
# All containers should show "healthy" status after ~60 seconds
# =============================================================================

# =============================================================================
# PORT SUMMARY
# =============================================================================
# Service          | Internal Port | External Port | Access URL
# -----------------|---------------|---------------|---------------------------
# Traefik Gateway  | 80            | 8002          | http://localhost:8002
# Traefik Dashboard| 8080          | 8080          | http://localhost:8080
# Auth Service     | 8001          | -             | via Traefik /api/v1/auth
# Product Service  | 8002          | -             | via Traefik /api/v1/products
# Order Service    | 8003          | -             | via Traefik /api/v1/orders
# Chat Service     | 8004          | -             | via Traefik /api/v1/chat
# Seller Service   | 8005          | -             | via Traefik /api/v1/seller
# AI Service       | 8006          | -             | via Traefik /api/v1/ai
# MySQL            | 3306          | 3308          | localhost:3308
# Redis            | 6379          | -             | internal only
# =============================================================================


# =============================================================================
# INTEL SERVICE (price & market intelligence)
# =============================================================================
# No model settings. The Ollama client and the three LLM features it served
# were removed on 2026-08-27 -- the deploy target cannot run a model. See
# docs/ai-features/05-price-intelligence.md section 2.
#
# Check the service:  curl -s localhost:8002/api/v1/intel/health
# "features.price_intel" reflects the flag below; there is no model to be
# unreachable, so a feature is on or off rather than degraded.

# On, matching the current deployment. This is the kill switch: turning it off
# hides the price-insights control in the app rather than leaving a button that
# 404s. Staged per seller through the Redis allowlist at
# mercai:intel:allowlist:price_intel -- an EMPTY set means everyone.
INTEL_PRICE_ENABLED=true

# Per-seller quotas, enforced in Redis. Fail OPEN if Redis is down.
AI_QUOTA_PER_HOUR=20
AI_QUOTA_PER_DAY=100

# The listing-optimizer, chat-copilot and review-intelligence flags used to sit
# here. All three were removed from shared/config.py on 2026-08-27 with the
# Ollama client -- the deploy target cannot run a model. The only feature flag
# left is INTEL_PRICE_ENABLED, in the INTEL SERVICE section below.
