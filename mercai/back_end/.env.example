# =============================================================================
# MERCAI - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env: cp .env.example .env
# For Docker deployment, use these settings as-is
# =============================================================================

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
ENVIRONMENT=production
DEBUG=false

# =============================================================================
# DATABASE CONFIGURATION - MySQL
# =============================================================================
#
# IMPORTANT: Understanding DB_HOST values
# ----------------------------------------
#
# Your server may have TWO MySQL instances:
#   1. Host MySQL    - Running directly on your server (port 3306)
#   2. Docker MySQL  - Running inside Docker container (mercai_mysql)
#
# ┌─────────────────────────────────────────────────────────────────────┐
# │                     YOUR SERVER (Host Machine)                       │
# │                                                                      │
# │  ┌────────────────────────────────────────┐                         │
# │  │         HOST MYSQL (Local)             │  ← Running directly     │
# │  │         Port: 3306                     │    on your server       │
# │  │         (NOT used by this app)         │                         │
# │  └────────────────────────────────────────┘                         │
# │                                                                      │
# │  ┌──────────────────────────────────────────────────────────────┐   │
# │  │                    DOCKER ENVIRONMENT                         │   │
# │  │                                                               │   │
# │  │  ┌─────────────────────┐    ┌─────────────────────────────┐  │   │
# │  │  │  mercai_mysql      │◄───│  Your App Services          │  │   │
# │  │  │  (Docker MySQL)     │    │  (auth, product, order...)  │  │   │
# │  │  │  Service name: "db" │    └─────────────────────────────┘  │   │
# │  │  └─────────────────────┘                                      │   │
# │  │           ▲                                                   │   │
# │  │           │ Docker Internal Network                           │   │
# │  │           │ Use "db" to connect (NOT localhost!)              │   │
# │  └──────────────────────────────────────────────────────────────┘   │
# └─────────────────────────────────────────────────────────────────────┘
#
# DB_HOST values:
#   - "db"                   → Docker MySQL container (CORRECT for Docker deployment)
#   - "host.docker.internal" → Host machine's MySQL (WRONG - different database!)
#   - "localhost"            → Host machine's MySQL (WRONG - different database!)
#
# ALWAYS use DB_HOST=db for Docker deployment!
#
DB_HOST=db
DB_PORT=3306
DB_NAME=mercai
DB_USER=mercai_user
DB_PASSWORD=Mysql_2025
DB_ROOT_PASSWORD=Mysql_2025

# External port for database access from host machine (for debugging)
# Connect from your machine: mysql -h localhost -P 3308 -u mercai_user -p
MERCAI_DB_PORT=3308

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# For Docker deployment: use container name "redis"
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_PORT=8002
API_BASE_URL=http://localhost:8002
FRONTEND_URL=http://localhost:3000

# CORS Configuration (comma-separated origins or * for all)
ALLOWED_ORIGINS=*

# Upload Configuration (bytes) - 10MB default
MAX_UPLOAD_SIZE=10485760

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# IMPORTANT: Change this in production!
# Generate secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_a_secure_random_string_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@mercai.com
SMTP_FROM_NAME=Mercai
SMTP_USE_TLS=true

# =============================================================================
# MICROSERVICES CONFIGURATION
# =============================================================================
# MySQL root password for docker-compose (used during container initialization)
MYSQL_ROOT_PASSWORD=Mysql_2025

# =============================================================================
# QUICK START
# =============================================================================
# 1. Copy this file:     cp .env.example .env
# 2. (Optional) Edit .env with your production values
# 3. Start services:     docker compose up -d
# 4. Check status:       docker compose ps
# 5. View logs:          docker compose logs -f
#
# All containers should show "healthy" status after ~60 seconds
# =============================================================================

# =============================================================================
# PORT SUMMARY
# =============================================================================
# Service          | Internal Port | External Port | Access URL
# -----------------|---------------|---------------|---------------------------
# Traefik Gateway  | 80            | 8002          | http://localhost:8002
# Traefik Dashboard| 8080          | 8080          | http://localhost:8080
# Auth Service     | 8001          | -             | via Traefik /api/v1/auth
# Product Service  | 8002          | -             | via Traefik /api/v1/products
# Order Service    | 8003          | -             | via Traefik /api/v1/orders
# Chat Service     | 8004          | -             | via Traefik /api/v1/chat
# Seller Service   | 8005          | -             | via Traefik /api/v1/seller
# MySQL            | 3306          | 3308          | localhost:3308
# Redis            | 6379          | -             | internal only
# =============================================================================
