# =============================================================================
# Stock Predict Full-Stack Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment
# IMPORTANT: Change all default passwords before deploying to production!
# =============================================================================

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=production
DEBUG=0

# =============================================================================
# DATABASE - MySQL
# =============================================================================
MYSQL_ROOT_PASSWORD=Mysql_2025
MYSQL_USER=stockuser
MYSQL_PASSWORD=stockpass
MYSQL_DATABASE=defaultdb

# =============================================================================
# MESSAGE BROKER - RabbitMQ
# =============================================================================
RABBITMQ_USER=stockuser
RABBITMQ_PASSWORD=stockpass
RABBITMQ_VHOST=/stock

# =============================================================================
# SECURITY - JWT
# =============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# MONITORING
# =============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3100

# =============================================================================
# AI / LLM (powers ai-insights sentiment + news classification)
# =============================================================================
# LLM_PROVIDER: auto | anthropic | openai | template
#   - "template" (or no keys) => deterministic canned text; news sentiment is always
#     neutral, so company good/bad notifications will NOT fire.
#   - "openai"   => any OpenAI-compatible API (OpenAI, DeepSeek, etc.) via LLM_BASE_URL.
#   - "anthropic"=> Claude (needs ANTHROPIC_API_KEY).
LLM_PROVIDER=openai
#
# --- DeepSeek (OpenAI-compatible) example ---
# Put your DeepSeek key in OPENAI_API_KEY (it is sent as the bearer token):
OPENAI_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_KEY
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
#
# --- OpenAI defaults (if you use OpenAI instead) ---
#   OPENAI_API_KEY=sk-...   LLM_MODEL=gpt-4o-mini   LLM_BASE_URL=https://api.openai.com/v1
#
# --- Anthropic (optional, only used when LLM_PROVIDER=anthropic or auto) ---
ANTHROPIC_API_KEY=

# =============================================================================
# DATA SOURCES
# =============================================================================
VNSTOCK_DATA_SOURCE=VCI

# =============================================================================
# FRONTEND
# =============================================================================
# Baked into the React build. deploy-interactive.sh auto-detects the host IP; set
# explicitly for a fixed host (LAN/remote access), e.g. http://10.1.10.42:18004
REACT_APP_API_URL=http://localhost:18004

# =============================================================================
# NEWS INGESTION (news-service)
# =============================================================================
# Company-news poll cadence in seconds (default 900 = 15 min). Stream A (macro) and the
# event-reaction bridge are toggled in docker-compose, off by default.
NEWS_COMPANY_POLL_INTERVAL=900

# =============================================================================
# OPTIONAL
# =============================================================================
# Local LLM model for knowledge-qa (Ollama), and decision-helper market gateway timeout.
OLLAMA_MODEL=llama3.1
MARKET_GATEWAY_TIMEOUT_MS=5000
