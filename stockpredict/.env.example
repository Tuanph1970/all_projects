# =============================================================================
# Stock Predict Full-Stack Environment Configuration  --  TEMPLATE
# =============================================================================
# THIS FILE IS COMMITTED TO GIT AND PUSHED TO GITHUB. Never put a real secret
# in it. Every value below marked PLACEHOLDER is deliberately a known-bad string
# that the services REFUSE TO BOOT WITH outside development (see
# stock-common/stock_common/secrets_validation.py) -- that refusal is the point,
# not a bug.
#
#   ./deploy.sh copies this file to .env verbatim when .env does not exist.
#   Your real values belong in .env, which is gitignored.
#
# WHERE TO KEEP THE REAL VALUES: a password manager, or an encrypted file --
#   gpg --symmetric --cipher-algo AES256 .env      # -> .env.gpg, safe anywhere
# Do NOT paste them back into this file. If a secret ever does land here and get
# pushed, rotating it is the only fix: git history keeps what was committed.
#
# GENERATE REAL VALUES:
#   openssl rand -hex 32     # JWT_SECRET_KEY
#   openssl rand -hex 20     # MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD / RABBITMQ_PASSWORD
#
# ROTATING AN ALREADY-RUNNING STACK is not just an .env edit -- the database
# already has the old password and the mysql container's healthcheck
# authenticates as root from its own environment, so:
#   1. ALTER USER '<user>'@'%' IDENTIFIED BY '<new>';   (in the running MySQL)
#   2. update .env
#   3. docker compose up -d --force-recreate mysql      (healthcheck reads the new value)
#   4. docker compose up -d --force-recreate            (services pick up the new value)
# Verify the OLD password is rejected afterwards, not just that the new one works.
# =============================================================================

# =============================================================================
# ENVIRONMENT
# =============================================================================
# "development" tolerates the placeholder secrets below and only WARNS about
# them, so a fresh clone can bring the stack up and look around. Any other value
# -- production, staging, test -- makes every service refuse to start until the
# secrets are real. Set this to production only together with real secrets.
ENVIRONMENT=development
DEBUG=0

# =============================================================================
# DATABASE - MySQL
# =============================================================================
# PLACEHOLDER -- refused outside development. openssl rand -hex 20
MYSQL_ROOT_PASSWORD=Mysql_2025
MYSQL_USER=stockuser
# PLACEHOLDER -- refused outside development. openssl rand -hex 20
# Note: news-service and event-reaction-service connect as ROOT (their
# DATABASE_URL embeds MYSQL_ROOT_PASSWORD), so both MySQL passwords matter.
MYSQL_PASSWORD=stockpass
MYSQL_DATABASE=defaultdb

# =============================================================================
# MESSAGE BROKER - RabbitMQ
# =============================================================================
RABBITMQ_USER=stockuser
# PLACEHOLDER -- refused outside development. openssl rand -hex 20
RABBITMQ_PASSWORD=stockpass
RABBITMQ_VHOST=/stock

# =============================================================================
# SECURITY - JWT
# =============================================================================
# PLACEHOLDER -- refused outside development. Generate with: openssl rand -hex 32
# This one signs every auth token, so a shared or published value lets anyone
# mint a session. A blank value is refused too: an empty secret is a zero-length
# signing key, not "unconfigured".
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# MONITORING
# =============================================================================
GRAFANA_USER=admin
# PLACEHOLDER. NOT covered by the startup guard -- Grafana is not one of the
# Python services, so nothing refuses to boot over this. Change it by hand
# before exposing Grafana beyond localhost.
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3100

# =============================================================================
# AI / LLM (powers ai-insights sentiment + news classification)
# =============================================================================
# LLM_PROVIDER: auto | anthropic | openai | template
#   - "template" (or no keys) => deterministic canned text; news sentiment is always
#     neutral, so company good/bad notifications will NOT fire.
#   - "openai"   => any OpenAI-compatible API (OpenAI, DeepSeek, etc.) via LLM_BASE_URL.
#   - "anthropic"=> Claude (needs ANTHROPIC_API_KEY).
LLM_PROVIDER=openai
#
# --- DeepSeek (OpenAI-compatible) example ---
# Put your DeepSeek key in OPENAI_API_KEY (it is sent as the bearer token):
OPENAI_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_KEY
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
#
# --- OpenAI defaults (if you use OpenAI instead) ---
#   OPENAI_API_KEY=sk-...   LLM_MODEL=gpt-4o-mini   LLM_BASE_URL=https://api.openai.com/v1
#
# --- Anthropic (optional, only used when LLM_PROVIDER=anthropic or auto) ---
ANTHROPIC_API_KEY=

# =============================================================================
# DATA SOURCES
# =============================================================================
VNSTOCK_DATA_SOURCE=VCI
# vnstock 4.x quota: 20 req/min without a key, 60 req/min with a free key from
# https://vnstocks.com/login . Leave empty to run as Guest (the sync self-throttles).
VNSTOCK_API_KEY=
# Override the spacing between vnstock calls (seconds). Empty = auto (3.1 guest / 1.05 with key).
VNSTOCK_MIN_INTERVAL_SECONDS=

# =============================================================================
# FRONTEND
# =============================================================================
# Baked into the React build at image-build time, so changing it needs a frontend
# rebuild, not just a restart. Set it explicitly for LAN/remote access, e.g.
# http://10.1.10.42:18004 -- ./deploy.sh does NOT auto-detect the host IP
# (checked 2026-11-02; an earlier comment here credited a deploy-interactive.sh
# that does not exist in this tree).
REACT_APP_API_URL=http://localhost:18004

# =============================================================================
# NEWS INGESTION (news-service)
# =============================================================================
# Company-news poll cadence in seconds (default 900 = 15 min). Stream A (macro) and the
# event-reaction bridge are toggled in docker-compose, off by default.
NEWS_COMPANY_POLL_INTERVAL=900

# =============================================================================
# OPTIONAL
# =============================================================================
# Local LLM model for knowledge-qa (Ollama), and decision-helper market gateway timeout.
OLLAMA_MODEL=llama3.1
MARKET_GATEWAY_TIMEOUT_MS=5000

# =============================================================================
# FEEDBACK INBOX (v0.9)
# =============================================================================
# Comma-separated addresses allowed to read ALL user feedback via
# GET /portfolio/feedback. Empty means nobody can, which is the safe default.
#
# This is an allowlist rather than a role because the deployed `users` table has
# no role column -- every JWT reports role=user, so a role-gated endpoint is
# unreachable by anyone. The `email` claim is signed with JWT_SECRET_KEY, so it
# is no weaker a basis than the user id. A real role column belongs with
# auth-service and would replace this.
FEEDBACK_ADMIN_EMAILS=
