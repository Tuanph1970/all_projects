# Auto_Test_API Environment Configuration
# Copy this file to .env and modify as needed

# Base URL for API Gateway (via Traefik)
BASE_URL=http://localhost:8004/stock_helper/api/v2

# Direct service URLs (optional, for debugging)
AUTH_SERVICE_URL=http://localhost:8007/stock_helper/api/v2
STOCK_DATA_SERVICE_URL=http://localhost:8001/stock_helper/api/v2
PORTFOLIO_SERVICE_URL=http://localhost:8003/stock_helper/api/v2
PREDICTION_SERVICE_URL=http://localhost:8002/stock_helper/api/v2
ANALYSIS_SERVICE_URL=http://localhost:8004/stock_helper/api/v2
AI_INSIGHTS_SERVICE_URL=http://localhost:8005/stock_helper/api/v2
CHATBOT_SERVICE_URL=http://localhost:8006/stock_helper/api/v2

# Test User Credentials (will be created during testing)
TEST_USER_EMAIL=autotest@stockhelper.com
TEST_USER_USERNAME=autotest_user
TEST_USER_PASSWORD=AutoTest@123
TEST_USER_FULL_NAME=Auto Test User

# Test Data
TEST_STOCK_SYMBOL=VNM
TEST_STOCK_SYMBOLS=["VNM", "FPT", "VIC", "HPG", "VCB"]

# Timeouts (seconds)
REQUEST_TIMEOUT=30
LONG_REQUEST_TIMEOUT=120

# Test Settings
VERBOSE=true
CLEANUP_AFTER_TEST=true
