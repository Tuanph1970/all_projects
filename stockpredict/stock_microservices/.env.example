# =============================================================================
# STOCK PREDICT MICROSERVICES - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env: cp .env.example .env
# For Docker deployment, use these settings as-is
# =============================================================================

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development
DEBUG=1

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Option 1: Local MySQL (recommended for new deployments)
# DB_HOST=db
# DB_PORT=3306

# Option 2: Remote MySQL via SSH Tunnel (current setup)
# SSH tunnel connects to remote server and forwards MySQL port
SSH_HOST=your-remote-server-ip
SSH_USER=your-ssh-user
SSH_PASSWORD=your-ssh-password

# MySQL credentials
MYSQL_USER=root
MYSQL_PASSWORD=Mysql_2025
MYSQL_ROOT_PASSWORD=Mysql_2025

# Database name
MYSQL_DATABASE=stockpredict_db

# External port for local access
STOCK_DB_PORT=3309

# =============================================================================
# MESSAGE BROKER - RabbitMQ
# =============================================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=stockuser
RABBITMQ_PASSWORD=stockpass
RABBITMQ_VHOST=/stock
RABBITMQ_MANAGEMENT_PORT=15672

# =============================================================================
# CACHE - Redis
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# External port for local access
STOCK_REDIS_PORT=6382

# =============================================================================
# SECURITY - JWT
# =============================================================================
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# API GATEWAY - Traefik
# =============================================================================
TRAEFIK_DASHBOARD_PORT=8089
TRAEFIK_ENTRYPOINT_PORT=8088

# =============================================================================
# MONITORING
# =============================================================================
GRAFANA_PORT=3100
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686

# =============================================================================
# AI SERVICES (Optional)
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4

# =============================================================================
# DATA SOURCES
# =============================================================================
VNSTOCK_DATA_SOURCE=VCI
# vnstock 4.x quota: 20 req/min without a key, 60 req/min with a free key from
# https://vnstocks.com/login . Leave empty to run as Guest (the sync self-throttles).
VNSTOCK_API_KEY=
# Override the spacing between vnstock calls (seconds). Empty = auto (3.1 guest / 1.05 with key).
VNSTOCK_MIN_INTERVAL_SECONDS=

# =============================================================================
# MICROSERVICE PORTS
# =============================================================================
AUTH_SERVICE_PORT=8007
DATA_SERVICE_PORT=8001
ANALYSIS_SERVICE_PORT=8004
PREDICTION_SERVICE_PORT=8002
AI_INSIGHTS_SERVICE_PORT=8005
CHATBOT_SERVICE_PORT=8006
PORTFOLIO_SERVICE_PORT=8013

# =============================================================================
# PORT SUMMARY (for reference)
# =============================================================================
# Auth Service:         8007
# Data Service:         8001
# Analysis Service:     8004
# Prediction Service:   8002 (internal)
# AI Insights Service:  8005
# Chatbot Service:      8006
# Portfolio Service:    8013
# Traefik Gateway:      8088
# Traefik Dashboard:    8089
# RabbitMQ:             5672 (AMQP), 15672 (Management)
# Redis:                6382 (external)
# MySQL:                3309 (external via SSH tunnel)
# Grafana:              3100
# Prometheus:           9090
# Jaeger:               16686
# =============================================================================
