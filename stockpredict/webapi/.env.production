# =============================================================================
# Stock Predict WebAPI - Production Environment Template
# =============================================================================
# For remote server deployment with MySQL on the same machine
#
# Copy this file to .env and fill in your values:
#   cp .env.production .env
#   nano .env

# -----------------------------------------------------------------------------
# Django Settings
# -----------------------------------------------------------------------------
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-secure-secret-key-here

# IMPORTANT: Set to False for production
DJANGO_DEBUG=False

# Add your server's IP and domain (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_SERVER_IP,your-domain.com

# -----------------------------------------------------------------------------
# Database Configuration (MySQL on same server)
# -----------------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=stockpredict
DB_USER=stockapi
DB_PASSWORD=your_mysql_password

# Use host.docker.internal to connect to MySQL on host machine
DB_HOST=host.docker.internal
DB_PORT=3306

# Disable SSL for local MySQL connection
DB_SSL=false

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Change this if port 8000 is already in use (e.g., 8080, 9000, 8888)
API_PORT=8080

# -----------------------------------------------------------------------------
# CORS Settings
# -----------------------------------------------------------------------------
# Add your frontend URLs (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://YOUR_SERVER_IP:3000

# -----------------------------------------------------------------------------
# Optional: LLM/AI Configuration
# -----------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
HUGGINGFACE_TOKEN=your-huggingface-token
POLYGON_API_KEY=your-polygon-api-key

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
