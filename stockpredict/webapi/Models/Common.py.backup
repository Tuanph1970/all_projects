def getModelParameterDetail(model_type):
    ret = []
    params = get_model_parameters(model_type)
    model_repo = ModelRepository()
    
    for param_name in params.keys():
        # Equivalent to getControlTypeAndText functionality
        query = "SELECT field_type, vn_name FROM tbl_dynamic_field WHERE field_name = %s"
        result = model_repo.execute_query(query, (param_name,))
        
        if result:
            field_info = result[0]
            param_info = {
                'param_name': param_name,
                'field_type': field_info['field_type'],
                'vn_name': field_info['vn_name']
            }
        else:
            param_info = {
                'param_name': param_name,
                'field_type': '',
                'vn_name': ''
            }
        ret.append(param_info)
    return ret

def getModelParameterFields(model_type):
    ret = []
    params = get_model_parameters(model_type)
    model_repo = ModelRepository()
    
    for param_name in params.keys():
        # Equivalent to getControlTypeAndText functionality
        query = "SELECT field_type, vn_name FROM tbl_dynamic_field WHERE field_name = %s"
        result = model_repo.execute_query(query, (param_name,))
        
        if result:
            field_info = result[0]
            param_info = {
                'param_name': param_name,
                'field_type': field_info['field_type'],
                'vn_name': field_info['vn_name']
            }
        else:
            param_info = {
                'param_name': param_name,
                'field_type': '',
                'vn_name': ''
            }
        ret.append(param_info)
    return ret











