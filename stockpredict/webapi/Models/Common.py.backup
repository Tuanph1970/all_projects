def get_all_predict_model():
    """
    Get all available prediction model types from database.

    Returns:
        List of dictionaries with structure:
        [
            {
                'name': 'BlockRNN',
                'sub_model': [{'name': 'LSTM'}, {'name': 'GRU'}, {'name': 'Vanilla'}]
            },
            ...
        ]
    """
    try:
        repo = AllModelsRepository()
        return repo.get_all_models_with_subtypes(active_only=True)
    except Exception as e:
        # Fallback to empty list if database query fails
        print(f"Error fetching model types from database: {e}")
        return []
def get_model_parameters_by_id(model_id,model_name,model_type):

    if model_type == "BlockRNN":
        file_name = os.path.join(model_name, model_name, str(model_id) + ".pt")
        model = BlockRNNPredictModel()
    elif model_type == "RNN":
        file_name = os.path.join(model_name,model_name,str(model_id) + ".pt")
        model = RNNPredictModel()
    elif model_type == "NBeats":
        file_name = os.path.join(model_name, model_name, str(model_id) + ".pt")
        model = NBeatsPredictModel()
    elif model_type == "NHits":
        file_name = os.path.join(model_name, model_name, str(model_id) + ".pt")
        model = NHitsPredictModel()
    elif model_type == "TCN":
        file_name = os.path.join(model_name, model_name, str(model_id) + ".pt")
        model = TCNPredictModel()
    elif model_type == "Transformer":
        file_name = os.path.join(model_name, model_name, str(model_id) + ".pt")
        model = TransformerPredictModel()
    elif model_type == "TFT":
        file_name = os.path.join(model_name, model_name, str(model_id) + ".pt")
        model = TFTPredictModel()
    elif model_type == "DLinear":
        file_name = os.path.join(model_name, model_name, str(model_id) + ".pt")
        model = DLinearPredictModel()
    elif model_type == "NLinear":
        file_name = os.path.join(model_name, model_name, str(model_id) + ".pt")
        model = NLinearPredictModel()
    elif model_type == "TiDE":
        file_name = os.path.join(model_name, model_name, str(model_id) + ".pt")
        model = TimeDeepEncoderPredictModel()
    elif model_type == "RandomForest":
        file_name = os.path.join(model_name, model_name, str(model_id) + ".pkl")
        model = RandomForestPredictModel()
    elif model_type == "LightGBM":
        file_name = os.path.join(model_name, model_name, str(model_id) + ".pkl")
        model = LightGBMPredictModel()
    elif model_type == "XGBoost":
        file_name = os.path.join(model_name, model_name, str(model_id) + ".pkl")
        model = XGBootsPredictModel()
    elif model_type == "CatBoost":
        file_name = os.path.join(model_name, model_name, str(model_id) + ".pkl")
        model = CatBoostPredictModel()
    model.load_model(file_name)
    ret = model.getModelConfigurationParam()
    ret['last_training_date'] = model.get_latest_training_date()
    return ret


def get_model_parameters(model):
    if model == "BlockRNN":
        model = BlockRNNPredictModel()
    elif model == "RNN":
        model = RNNPredictModel()
    elif model == "NBeats":
        model = NBeatsPredictModel()
    elif model == "NHits":
        model = NHitsPredictModel()
    elif model == "TCN":
        model = TCNPredictModel()
    elif model == "Transformer":
        model = TransformerPredictModel()
    elif model == "TFT":
        model = TFTPredictModel()
    elif model == "DLinear":
        model = DLinearPredictModel()
    elif model == "NLinear":
        model = NLinearPredictModel()
    elif model == "TiDE":
        model = TimeDeepEncoderPredictModel()
    elif model == "RandomForest":
        model = RandomForestPredictModel()
    elif model == "LightGBM":
        model = LightGBMPredictModel()
    elif model == "XGBoost":
        model = XGBootsPredictModel()
    elif model == "CatBoost":
        model = CatBoostPredictModel()
    else:
        model = None
    return model.getModelConfigurationParam()
def create_rnn_model(model_id,data):
    model = RNNPredictModel()
    model.setModelConfigurationParam(
        model_sub_type= data['model_sub_type'],
        input_chunk_length=data['input_chunk_length'],
        hidden_dim= data['hidden_dim'],
        n_rnn_layers=data['n_rnn_layers'],
        dropout=data['dropout'],
        batch_size=data['batch_size'],
        n_epochs= data['n_epochs'],
        learning_rate=data['learning_rate'],
        training_length=data['training_length'],
    )
    file_name = str(model_id) + ".pt"

    model.save_model(file_name,data['model_name'])
    return model.getModelConfigurationParam()
def save_rnn_model(data):
    model = RNNPredictModel()
    file_name = str(data['model_id']) + ".pt"
    model_name = data['model_name']
    path = os.getcwd()
    file_name = os.path.join(path,model_name,model_name,file_name)
    model.load_model(file_name)
    model.setModelConfigurationParam(
        model_sub_type= data['model_sub_type'],
        input_chunk_length=data['input_chunk_length'],
        hidden_dim=data['hidden_dim'],
        n_rnn_layers=data['n_rnn_layers'],
        dropout=data['dropout'],
        batch_size=data['batch_size'],
        n_epochs=data['n_epochs'],
        learning_rate=data['learning_rate'],
        training_length=data['training_length'],

    )
    model.save_model(file_name, data['model_name'])
    return model.getModelConfigurationParam()
