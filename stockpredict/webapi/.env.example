# =============================================================================
# Stock Predict WebAPI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env file to version control!

# -----------------------------------------------------------------------------
# Django Settings
# -----------------------------------------------------------------------------
# Generate a new secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# -----------------------------------------------------------------------------
# Database Configuration (MySQL)
# -----------------------------------------------------------------------------
# Your external MySQL server connection details
DB_ENGINE=django.db.backends.mysql
DB_NAME=defaultdb
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL=false

# SSH Tunnel Configuration (for remote MySQL servers)
# Set SSH_ENABLED=true to use SSH tunnel for database connection
SSH_ENABLED=false
SSH_HOST=your-server-ip
SSH_PORT=22
SSH_USER=your-ssh-user
SSH_PASSWORD=your-ssh-password

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Port to expose the API (default: 8000)
API_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# Optional: LLM/AI Configuration
# -----------------------------------------------------------------------------
# Groq API key for chatbot functionality
GROQ_API_KEY=your-groq-api-key

# HuggingFace token for model downloads
HUGGINGFACE_TOKEN=your-huggingface-token

# -----------------------------------------------------------------------------
# Optional: Stock Data API Keys
# -----------------------------------------------------------------------------
# Polygon.io API key
POLYGON_API_KEY=your-polygon-api-key

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
