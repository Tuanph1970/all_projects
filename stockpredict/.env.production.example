# =============================================================================
# Stock Predict — Production Environment Variables
# =============================================================================
# Instructions:
#   1. Copy this file:  cp .env.production.example .env
#   2. Fill in every value marked with <CHANGE_ME>
#   3. Run:  ./deploy.sh
# =============================================================================

ENVIRONMENT=production

# --- MySQL -------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=<CHANGE_ME>
MYSQL_USER=<CHANGE_ME>
MYSQL_PASSWORD=<CHANGE_ME>
MYSQL_DATABASE=defaultdb

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=<CHANGE_ME>

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=<CHANGE_ME>
RABBITMQ_PASSWORD=<CHANGE_ME>
RABBITMQ_VHOST=/stock

# --- JWT Authentication ------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=<CHANGE_ME>

# --- Grafana -----------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=<CHANGE_ME>
GRAFANA_PORT=3100

# --- Neo4j (Knowledge QA service) -------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=<CHANGE_ME>

# --- AI / LLM ----------------------------------------------------------------
ANTHROPIC_API_KEY=<CHANGE_ME>
OPENAI_API_KEY=<CHANGE_ME>
LLM_MODEL=gpt-4
OLLAMA_MODEL=llama3.1

# --- Stock data --------------------------------------------------------------
VNSTOCK_DATA_SOURCE=VCI
MARKET_GATEWAY_TIMEOUT_MS=10000

# --- Debug -------------------------------------------------------------------
DEBUG=0
