          "unit": "ms"
        }
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 15},
      "id": 20,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(shadow_django_latency_seconds_bucket[5m])) by (le, endpoint)) * 1000",
