          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(shadow_microservice_latency_seconds_bucket[5m])) by (le, endpoint)) * 1000",
          "legendFormat": "MS {{endpoint}}",
          "refId": "B"
        }
      ],
      "title": "P99 Latency Comparison",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {"drawStyle": "line", "fillOpacity": 20},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 100}
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 15},
      "id": 21,
      "targets": [
        {
          "expr": "shadow_latency_difference_seconds * 1000",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "Latency Difference (MS - Django)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 10}
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 15},
      "id": 22,
      "targets": [
        {
          "expr": "(1 - sum(rate(shadow_comparisons_total{status=\"match\"}[5m])) / sum(rate(shadow_comparisons_total[5m]))) * 100",
          "legendFormat": "Mismatch Rate",
          "refId": "A"
        }
      ],
      "title": "Response Mismatch Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
