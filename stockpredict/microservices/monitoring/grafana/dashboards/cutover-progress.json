    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 30},
      "id": 104,
      "panels": [],
      "title": "Cutover Timeline",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "continuous-GrYlRd"},
          "custom": {"fillOpacity": 70, "lineWidth": 0},
          "mappings": [],
          "max": 100,
          "min": 0,
