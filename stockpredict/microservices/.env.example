# Stock Helper Microservices Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# GENERAL
# =============================================================================
DEBUG=0
ENVIRONMENT=development

# =============================================================================
# DATABASE (MySQL)
# =============================================================================
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_USER=stockuser
MYSQL_PASSWORD=stockpass
MYSQL_DATABASE=defaultdb

# Per-service database names
DB_AUTH_NAME=auth_db
DB_STOCKDATA_NAME=stockdata_db
DB_PORTFOLIO_NAME=portfolio_db
DB_PREDICTION_NAME=prediction_db

# =============================================================================
# MESSAGE BROKER (RabbitMQ)
# =============================================================================
RABBITMQ_USER=stockuser
RABBITMQ_PASSWORD=stockpass
RABBITMQ_VHOST=/stock
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# =============================================================================
# CACHE (Redis)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# AUTHENTICATION (JWT)
# =============================================================================
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# OBSERVABILITY
# =============================================================================
# Tracing
TRACING_ENABLED=true
TRACING_JAEGER_HOST=jaeger
TRACING_JAEGER_PORT=6831
TRACING_SAMPLE_RATE=1.0

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# =============================================================================
# RESILIENCE
# =============================================================================
RESILIENCE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
RESILIENCE_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30
RESILIENCE_RETRY_MAX_ATTEMPTS=3
RESILIENCE_TIMEOUT_DEFAULT=30.0

# =============================================================================
# SERVICE URLS (for inter-service communication)
# =============================================================================
AUTH_SERVICE_URL=http://auth-service:8007
STOCK_DATA_SERVICE_URL=http://stock-data-service:8001
PORTFOLIO_SERVICE_URL=http://portfolio-service:8003
ANALYSIS_SERVICE_URL=http://analysis-service:8004
PREDICTION_SERVICE_URL=http://prediction-service:8002
AI_INSIGHTS_SERVICE_URL=http://ai-insights-service:8005
CHATBOT_SERVICE_URL=http://chatbot-service:8006

# =============================================================================
# EXTERNAL APIS (for stock data services)
# =============================================================================
# VNStock (default data source)
VNSTOCK_DATA_SOURCE=VCI

# Groq LLM (for AI services)
GROQ_API_KEY=your-groq-api-key

# =============================================================================
# LEGACY DJANGO (for transition period)
# =============================================================================
DJANGO_SECRET_KEY=change-this-in-production
