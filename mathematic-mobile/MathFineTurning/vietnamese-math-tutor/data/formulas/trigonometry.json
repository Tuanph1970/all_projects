{
  "metadata": {
    "category": "trigonometry",
    "category_vi": "Luong giac",
    "grade": 12,
    "description": "Cong thuc luong giac lop 12"
  },
  "formulas": [
    {
      "id": "trig_001",
      "name": "pythagorean_identity",
      "name_vi": "Hang dang thuc co ban",
      "formula": "sin^2(x) + cos^2(x) = 1",
      "description_vi": "Hang dang thuc luong giac co ban",
      "description_en": "Pythagorean identity",
      "keywords": ["luong giac", "hang dang thuc", "sin", "cos"],
      "examples": ["sin^2(30) + cos^2(30) = 1/4 + 3/4 = 1"]
    },
    {
      "id": "trig_002",
      "name": "tan_definition",
      "name_vi": "Dinh nghia tan",
      "formula": "tan(x) = sin(x) / cos(x)",
      "description_vi": "Tang cua goc bang sin chia cos",
      "description_en": "Tangent equals sine over cosine",
      "keywords": ["luong giac", "tan", "tangent"],
      "examples": ["tan(45) = sin(45)/cos(45) = 1"]
    },
    {
      "id": "trig_003",
      "name": "cot_definition",
      "name_vi": "Dinh nghia cot",
      "formula": "cot(x) = cos(x) / sin(x) = 1 / tan(x)",
      "description_vi": "Cotang cua goc bang cos chia sin",
      "description_en": "Cotangent equals cosine over sine",
      "keywords": ["luong giac", "cot", "cotangent"],
      "examples": ["cot(45) = 1/tan(45) = 1"]
    },
    {
      "id": "trig_004",
      "name": "tan_cot_identity",
      "name_vi": "Hang dang thuc tan cot",
      "formula": "1 + tan^2(x) = 1/cos^2(x), 1 + cot^2(x) = 1/sin^2(x)",
      "description_vi": "Cac hang dang thuc lien quan tan va cot",
      "description_en": "Identities involving tan and cot",
      "keywords": ["luong giac", "tan", "cot", "hang dang thuc"],
      "examples": ["1 + tan^2(x) = sec^2(x)"]
    },
    {
      "id": "trig_005",
      "name": "sum_angles_sin",
      "name_vi": "Sin cua tong hai goc",
      "formula": "sin(a + b) = sin(a)cos(b) + cos(a)sin(b)",
      "description_vi": "Cong thuc sin cua tong hai goc",
      "description_en": "Sine of sum of angles",
      "keywords": ["luong giac", "sin", "tong", "goc"],
      "examples": ["sin(75) = sin(45+30) = sin45cos30 + cos45sin30"]
    },
    {
      "id": "trig_006",
      "name": "sum_angles_cos",
      "name_vi": "Cos cua tong hai goc",
      "formula": "cos(a + b) = cos(a)cos(b) - sin(a)sin(b)",
      "description_vi": "Cong thuc cos cua tong hai goc",
      "description_en": "Cosine of sum of angles",
      "keywords": ["luong giac", "cos", "tong", "goc"],
      "examples": ["cos(75) = cos(45+30) = cos45cos30 - sin45sin30"]
    },
    {
      "id": "trig_007",
      "name": "diff_angles_sin",
      "name_vi": "Sin cua hieu hai goc",
      "formula": "sin(a - b) = sin(a)cos(b) - cos(a)sin(b)",
      "description_vi": "Cong thuc sin cua hieu hai goc",
      "description_en": "Sine of difference of angles",
      "keywords": ["luong giac", "sin", "hieu", "goc"],
      "examples": ["sin(15) = sin(45-30) = sin45cos30 - cos45sin30"]
    },
    {
      "id": "trig_008",
      "name": "diff_angles_cos",
      "name_vi": "Cos cua hieu hai goc",
      "formula": "cos(a - b) = cos(a)cos(b) + sin(a)sin(b)",
      "description_vi": "Cong thuc cos cua hieu hai goc",
      "description_en": "Cosine of difference of angles",
      "keywords": ["luong giac", "cos", "hieu", "goc"],
      "examples": ["cos(15) = cos(45-30) = cos45cos30 + sin45sin30"]
    },
    {
      "id": "trig_009",
      "name": "double_angle_sin",
      "name_vi": "Sin goc gap doi",
      "formula": "sin(2a) = 2*sin(a)*cos(a)",
      "description_vi": "Cong thuc nhan doi goc cho sin",
      "description_en": "Double angle formula for sine",
      "keywords": ["luong giac", "sin", "nhan doi", "goc"],
      "examples": ["sin(60) = 2*sin(30)*cos(30) = 2*(1/2)*(sqrt(3)/2) = sqrt(3)/2"]
    },
    {
      "id": "trig_010",
      "name": "double_angle_cos",
      "name_vi": "Cos goc gap doi",
      "formula": "cos(2a) = cos^2(a) - sin^2(a) = 2cos^2(a) - 1 = 1 - 2sin^2(a)",
      "description_vi": "Cong thuc nhan doi goc cho cos (3 dang)",
      "description_en": "Double angle formula for cosine (3 forms)",
      "keywords": ["luong giac", "cos", "nhan doi", "goc"],
      "examples": ["cos(60) = 2cos^2(30) - 1 = 2*(3/4) - 1 = 1/2"]
    },
    {
      "id": "trig_011",
      "name": "half_angle_sin",
      "name_vi": "Sin nua goc",
      "formula": "sin^2(a/2) = (1 - cos(a)) / 2",
      "description_vi": "Cong thuc ha bac cho sin binh phuong",
      "description_en": "Half angle formula for sine",
      "keywords": ["luong giac", "sin", "nua goc", "ha bac"],
      "examples": ["sin^2(15) = (1 - cos(30))/2 = (1 - sqrt(3)/2)/2"]
    },
    {
      "id": "trig_012",
      "name": "half_angle_cos",
      "name_vi": "Cos nua goc",
      "formula": "cos^2(a/2) = (1 + cos(a)) / 2",
      "description_vi": "Cong thuc ha bac cho cos binh phuong",
      "description_en": "Half angle formula for cosine",
      "keywords": ["luong giac", "cos", "nua goc", "ha bac"],
      "examples": ["cos^2(15) = (1 + cos(30))/2 = (1 + sqrt(3)/2)/2"]
    },
    {
      "id": "trig_013",
      "name": "sum_to_product_sin",
      "name_vi": "Bien tong thanh tich sin",
      "formula": "sin(a) + sin(b) = 2*sin((a+b)/2)*cos((a-b)/2)",
      "description_vi": "Cong thuc bien tong sin thanh tich",
      "description_en": "Sum to product: sin a + sin b",
      "keywords": ["luong giac", "sin", "tong", "tich"],
      "examples": ["sin(75) + sin(15) = 2*sin(45)*cos(30)"]
    },
    {
      "id": "trig_014",
      "name": "sum_to_product_cos",
      "name_vi": "Bien tong thanh tich cos",
      "formula": "cos(a) + cos(b) = 2*cos((a+b)/2)*cos((a-b)/2)",
      "description_vi": "Cong thuc bien tong cos thanh tich",
      "description_en": "Sum to product: cos a + cos b",
      "keywords": ["luong giac", "cos", "tong", "tich"],
      "examples": ["cos(75) + cos(15) = 2*cos(45)*cos(30)"]
    },
    {
      "id": "trig_015",
      "name": "product_to_sum_sin_cos",
      "name_vi": "Bien tich thanh tong sin cos",
      "formula": "2*sin(a)*cos(b) = sin(a+b) + sin(a-b)",
      "description_vi": "Cong thuc bien tich thanh tong",
      "description_en": "Product to sum: 2 sin a cos b",
      "keywords": ["luong giac", "sin", "cos", "tich", "tong"],
      "examples": ["2*sin(45)*cos(30) = sin(75) + sin(15)"]
    },
    {
      "id": "trig_016",
      "name": "special_values_sin",
      "name_vi": "Gia tri dac biet sin",
      "formula": "sin(0)=0, sin(30)=1/2, sin(45)=sqrt(2)/2, sin(60)=sqrt(3)/2, sin(90)=1",
      "description_vi": "Cac gia tri dac biet cua ham sin",
      "description_en": "Special values of sine function",
      "keywords": ["luong giac", "sin", "gia tri dac biet"],
      "examples": ["sin(30) = 1/2", "sin(60) = sqrt(3)/2"]
    },
    {
      "id": "trig_017",
      "name": "special_values_cos",
      "name_vi": "Gia tri dac biet cos",
      "formula": "cos(0)=1, cos(30)=sqrt(3)/2, cos(45)=sqrt(2)/2, cos(60)=1/2, cos(90)=0",
      "description_vi": "Cac gia tri dac biet cua ham cos",
      "description_en": "Special values of cosine function",
      "keywords": ["luong giac", "cos", "gia tri dac biet"],
      "examples": ["cos(30) = sqrt(3)/2", "cos(60) = 1/2"]
    },
    {
      "id": "trig_018",
      "name": "special_values_tan",
      "name_vi": "Gia tri dac biet tan",
      "formula": "tan(0)=0, tan(30)=sqrt(3)/3, tan(45)=1, tan(60)=sqrt(3)",
      "description_vi": "Cac gia tri dac biet cua ham tan",
      "description_en": "Special values of tangent function",
      "keywords": ["luong giac", "tan", "gia tri dac biet"],
      "examples": ["tan(45) = 1", "tan(60) = sqrt(3)"]
    },
    {
      "id": "trig_019",
      "name": "sin_negative_angle",
      "name_vi": "Sin goc am",
      "formula": "sin(-x) = -sin(x)",
      "description_vi": "Sin la ham le: sin(-x) = -sin(x)",
      "description_en": "Sine is odd function",
      "keywords": ["luong giac", "sin", "goc am", "ham le"],
      "examples": ["sin(-30) = -sin(30) = -1/2"]
    },
    {
      "id": "trig_020",
      "name": "cos_negative_angle",
      "name_vi": "Cos goc am",
      "formula": "cos(-x) = cos(x)",
      "description_vi": "Cos la ham chan: cos(-x) = cos(x)",
      "description_en": "Cosine is even function",
      "keywords": ["luong giac", "cos", "goc am", "ham chan"],
      "examples": ["cos(-30) = cos(30) = sqrt(3)/2"]
    },
    {
      "id": "trig_021",
      "name": "supplementary_sin",
      "name_vi": "Sin goc bu",
      "formula": "sin(180 - x) = sin(x)",
      "description_vi": "Sin cua goc bu bang sin cua goc",
      "description_en": "Sine of supplementary angle",
      "keywords": ["luong giac", "sin", "goc bu"],
      "examples": ["sin(150) = sin(180-150) = sin(30) = 1/2"]
    },
    {
      "id": "trig_022",
      "name": "supplementary_cos",
      "name_vi": "Cos goc bu",
      "formula": "cos(180 - x) = -cos(x)",
      "description_vi": "Cos cua goc bu bang tru cos cua goc",
      "description_en": "Cosine of supplementary angle",
      "keywords": ["luong giac", "cos", "goc bu"],
      "examples": ["cos(150) = -cos(30) = -sqrt(3)/2"]
    },
    {
      "id": "trig_023",
      "name": "complementary_sin_cos",
      "name_vi": "Sin cos goc phu",
      "formula": "sin(90 - x) = cos(x), cos(90 - x) = sin(x)",
      "description_vi": "Sin goc phu bang cos, cos goc phu bang sin",
      "description_en": "Complementary angle identities",
      "keywords": ["luong giac", "sin", "cos", "goc phu"],
      "examples": ["sin(60) = cos(30)", "cos(60) = sin(30)"]
    }
  ]
}
