# ============================================================
# Mathematics LLM OCR Service — Environment Variables
# ============================================================
# Copy this file to .env and fill in values before starting.
#
#   cp .env.example .env
#
# Lines starting with # are comments.
# All values shown are the application defaults.
# ============================================================


# ── Application ──────────────────────────────────────────────
APP_NAME="Mathematics LLM OCR Service"
APP_VERSION="0.1.0"
APP_DESCRIPTION="AI-powered mathematical OCR and problem solving service"

# ── API server ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8002
API_DEBUG=false
API_RELOAD=false
API_WORKERS=1

# File upload limits
MAX_FILE_SIZE=10485760          # 10 MB in bytes

# Rate limiting
RATE_LIMIT_REQUESTS=100         # max requests per window
RATE_LIMIT_WINDOW=60            # window size in seconds

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true


# ── ML Models ─────────────────────────────────────────────────
MODELS_PATH=./models
ML_DEVICE=cpu                   # cpu | cuda | mps

# OCR model (HuggingFace model ID or local path)
OCR_MODEL_NAME=microsoft/trocr-base-handwritten
OCR_CONFIDENCE_THRESHOLD=0.8
OCR_MAX_IMAGE_SIZE=2048

# Solution model (HuggingFace model ID or local path)
LLM_MODEL_NAME=google/flan-t5-base
LLM_MAX_LENGTH=512
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9

ML_BATCH_SIZE=1
ML_MAX_CONCURRENT=10
ML_REQUEST_TIMEOUT=30

# Optional — speeds up model downloads
# HUGGINGFACE_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── Redis (task store) ────────────────────────────────────────
# Docker Compose: redis://redis:6379/0
# Local:          redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_MAX_CONNECTIONS=20


# ── Security ─────────────────────────────────────────────────
# REQUIRED IN PRODUCTION: change before deploying
SECRET_KEY=change-me-in-production

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_HEADER=X-API-Key

# Comma-separated list of valid API keys (leave empty to disable auth)
# Example: VALID_API_KEYS=key-alpha,key-beta,key-gamma
VALID_API_KEYS=


# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                 # json | text
LOG_FILE_PATH=                  # leave empty to disable file logging
LOG_MAX_FILE_SIZE=100MB
LOG_BACKUP_COUNT=5

SERVICE_NAME=math-llm-ocr
SERVICE_VERSION=0.1.0
ENVIRONMENT=development         # development | staging | production


# ── Monitoring & Observability ───────────────────────────────
ENABLE_METRICS=true
METRICS_PORT=9090

# OpenTelemetry tracing
ENABLE_TRACING=false
# OTLP HTTP endpoint — set this when ENABLE_TRACING=true
# Docker Compose: http://jaeger:4318/v1/traces
# Remote Jaeger:  http://<host>:4318/v1/traces
JAEGER_ENDPOINT=

HEALTH_CHECK_INTERVAL=30


# ── Grafana (Docker Compose monitoring profile only) ──────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin          # change in production
JAEGER_UI_PORT=16686


# ── Developer flags ───────────────────────────────────────────
ENABLE_DOCS=true                # Swagger UI at /docs
ENABLE_DEBUG_ENDPOINTS=false    # Set true in development only


# ── External services (optional) ─────────────────────────────
BACKEND_API_URL=http://localhost:8001/api
BACKEND_TIMEOUT=30
