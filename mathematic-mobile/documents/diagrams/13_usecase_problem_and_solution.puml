@startuml 13_UseCase_Problem_And_Solution
title Problem Management & Solution Operations - Use Case Diagram

skinparam usecase {
    BackgroundColor WhiteSmoke
    BorderColor DarkSlateGray
    ArrowColor DarkSlateGray
    FontSize 11
}

left to right direction

actor "Registered User" as User
actor "ML Service\n(TrOCR + FLAN-T5)" as ML
actor "File Storage" as Storage
actor "Share Target\n(Email, Social)" as ShareTarget

rectangle "Problem Management" {
    usecase "Create Problem\nRecord" as UC_Create
    usecase "Set Title &\nDescription" as UC_SetTitle
    usecase "Select Category\n(Algebra/Calculus/...)" as UC_Category
    usecase "Select Difficulty\n(Easy/Med/Hard)" as UC_Difficulty

    usecase "Capture Image\nfrom Camera" as UC_Camera
    usecase "Select from\nGallery" as UC_Gallery
    usecase "Check Image\nQuality (0-100%)" as UC_Quality
    usecase "Crop & Rotate\nImage" as UC_Crop
    usecase "Compress Image\n(60-80% reduction)" as UC_Compress
    usecase "Upload Image\nto Problem" as UC_Upload

    usecase "View Problem\nHistory (paginated)" as UC_History
    usecase "Search Problems\nby Text" as UC_Search
    usecase "Filter by Category\n/ Status / Date" as UC_Filter
    usecase "Sort Problems" as UC_Sort

    usecase "View Problem\nDetail" as UC_Detail
    usecase "Update Problem\nMetadata" as UC_Update
    usecase "Delete Problem" as UC_Delete
    usecase "Retry Failed\nProblem" as UC_Retry

    usecase "View Problem\nStatistics" as UC_Stats
}

rectangle "Solution Operations" {
    usecase "Extract Text\nvia OCR" as UC_OCR
    usecase "Parse Math\nExpressions" as UC_Parse
    usecase "Solve Algebraic\nEquations" as UC_Algebra
    usecase "Solve Calculus\nProblems" as UC_Calculus
    usecase "Solve Geometry\nProblems" as UC_Geometry
    usecase "Generate Step-by-Step\nSolution" as UC_Steps

    usecase "View Solution\n(current step)" as UC_ViewSol
    usecase "Navigate Steps\n(prev/next)" as UC_Navigate
    usecase "Render Math\nFormulas (KaTeX)" as UC_Render

    usecase "Rate Solution\n(1-5 stars)" as UC_Rate
    usecase "Leave Feedback\nComment" as UC_Feedback

    usecase "Bookmark Solution" as UC_Bookmark
    usecase "Add Notes to\nBookmark" as UC_Notes
    usecase "View Saved\nBookmarks" as UC_ViewBookmarks
    usecase "Search Bookmarks" as UC_SearchBookmarks

    usecase "Share Solution" as UC_Share
    usecase "Export as Image\n(Screenshot)" as UC_Image
    usecase "Export as PDF" as UC_PDF
    usecase "Copy Text to\nClipboard" as UC_Copy
    usecase "Share Link" as UC_Link
}

' User interactions
User --> UC_Camera
User --> UC_Gallery
User --> UC_Create
User --> UC_History
User --> UC_Search
User --> UC_ViewSol
User --> UC_Rate
User --> UC_Bookmark
User --> UC_Share
User --> UC_Stats

' Include relationships - problem creation flow
UC_Create ..> UC_SetTitle : <<include>>
UC_Create ..> UC_Category : <<include>>
UC_Create ..> UC_Difficulty : <<include>>
UC_Camera ..> UC_Quality : <<include>>
UC_Gallery ..> UC_Quality : <<include>>
UC_Camera ..> UC_Compress : <<include>>
UC_Gallery ..> UC_Compress : <<include>>
UC_Upload ..> UC_OCR : <<include>>
UC_Camera ..> UC_Crop : <<extend>>
UC_Gallery ..> UC_Crop : <<extend>>

' Include relationships - search/filter
UC_History ..> UC_Filter : <<extend>>
UC_History ..> UC_Search : <<extend>>
UC_History ..> UC_Sort : <<extend>>

' Include relationships - solution view
UC_ViewSol ..> UC_Navigate : <<include>>
UC_ViewSol ..> UC_Render : <<include>>
UC_Rate ..> UC_Feedback : <<extend>>
UC_Bookmark ..> UC_Notes : <<extend>>
UC_ViewBookmarks ..> UC_SearchBookmarks : <<extend>>

' Share extensions
UC_Share ..> UC_Image : <<extend>>
UC_Share ..> UC_PDF : <<extend>>
UC_Share ..> UC_Copy : <<extend>>
UC_Share ..> UC_Link : <<extend>>

' ML Service
ML --> UC_OCR : processes
ML --> UC_Parse : processes
ML --> UC_Algebra : solves
ML --> UC_Calculus : solves
ML --> UC_Geometry : solves
ML --> UC_Steps : generates

UC_OCR ..> UC_Parse : <<include>>
UC_Parse ..> UC_Algebra : <<extend>>
UC_Parse ..> UC_Calculus : <<extend>>
UC_Parse ..> UC_Geometry : <<extend>>
UC_Algebra ..> UC_Steps : <<include>>
UC_Calculus ..> UC_Steps : <<include>>
UC_Geometry ..> UC_Steps : <<include>>

' External actors
Storage --> UC_Upload : stores images
ShareTarget --> UC_Share : receives

@enduml
