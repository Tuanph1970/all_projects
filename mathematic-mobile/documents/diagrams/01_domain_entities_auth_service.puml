@startuml 01_Domain_Entities_Auth_Service
title Auth Service - Domain Entities (Class Diagram)

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor WhiteSmoke
    BorderColor DarkSlateGray
    ArrowColor DarkSlateGray
    FontSize 12
}

package "Domain.Common" {
    abstract class BaseEntity {
        + Id : Guid
        + CreatedAt : DateTime
        + UpdatedAt : DateTime?
        - _domainEvents : List<IDomainEvent>
        + GetDomainEvents() : IReadOnlyList<IDomainEvent>
        + ClearDomainEvents() : void
        # AddDomainEvent(event: IDomainEvent) : void
    }

    interface IDomainEvent {
    }
}

package "Domain.Entities" {
    class User {
        + Username : string
        + Email : string
        + PasswordHash : string
        + FullName : string?
        + Role : string
        + IsActive : bool
        + LastLoginAt : DateTime?
        --
        + {static} Create(username, email, passwordHash, fullName) : User
        + RecordLogin() : void
        + UpdateProfile(fullName, email) : void
        + ChangePassword(newPasswordHash) : void
        + Deactivate() : void
    }
}

package "Domain.Enums" {
    enum UserRole {
        User
        Admin
        Moderator
    }
}

package "Domain.ValueObjects" {
    class RefreshToken {
        + Token : string
        + ExpiresAt : DateTime
        + CreatedAt : DateTime
        + UserId : Guid
        + IsExpired : bool
        --
        + {static} Create(userId, token, daysToExpire) : RefreshToken
        + IsValid() : bool
    }
}

package "Application.Common.Interfaces" {
    interface IUserRepository {
        + GetByIdAsync(id: Guid) : Task<User?>
        + GetByUsernameAsync(username: string) : Task<User?>
        + GetByEmailAsync(email: string) : Task<User?>
        + AddAsync(user: User) : Task
        + UpdateAsync(user: User) : Task
        + ExistsAsync(username, email) : Task<bool>
    }

    interface IUnitOfWork {
        + Users : IUserRepository
        + SaveChangesAsync() : Task<int>
    }

    interface IJwtTokenGenerator {
        + GenerateAccessToken(user: User) : string
        + GenerateRefreshToken() : string
        + GetPrincipalFromToken(token: string) : ClaimsPrincipal
    }

    interface IPasswordHasher {
        + HashPassword(password: string) : string
        + VerifyPassword(password, hash: string) : bool
    }
}

BaseEntity <|-- User
User --> UserRole : has
User ..> RefreshToken : generates
IUserRepository ..> User : manages
IUnitOfWork --> IUserRepository : contains

@enduml
