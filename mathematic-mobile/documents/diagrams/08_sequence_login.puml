@startuml 08_Sequence_Login
title User Login & Auto Token Refresh - Sequence Diagram

skinparam sequenceMessageAlign center
skinparam sequence {
    ArrowColor DarkSlateGray
    ActorBorderColor DarkSlateGray
    LifeLineBorderColor DarkSlateGray
    ParticipantBorderColor DarkSlateGray
    ParticipantBackgroundColor WhiteSmoke
}

actor User
participant "LoginScreen\n(React Native)" as Screen
participant "authSlice\n(Redux)" as Redux
participant "AuthService\n(Frontend)" as AuthSvc
participant "ApiClient\n(Axios)" as ApiClient
participant "AuthController\n(.NET)" as Controller
participant "LoginCommandHandler\n(.NET)" as Handler
participant "UserRepository\n(EF Core)" as Repo
database "MySQL\n(Auth DB)" as DB
participant "Redis Cache\n(Refresh Tokens)" as Redis
participant "IJwtTokenGenerator\n(.NET)" as JWT
participant "SecureStore\n(Expo)" as Storage

== Login Flow ==

User -> Screen : Enter credentials\n(username/email + password)
User -> Screen : Tap "Login"

Screen -> Redux : dispatch(loginUser({usernameOrEmail, password}))
activate Redux

Redux -> AuthSvc : login(usernameOrEmail, password)
activate AuthSvc

AuthSvc -> ApiClient : POST /api/v1/auth/login\n{usernameOrEmail, password}
activate ApiClient

ApiClient -> Controller : HTTP POST
activate Controller

Controller -> Handler : Send(LoginCommand)
activate Handler

Handler -> Repo : GetByUsernameAsync(usernameOrEmail)\nor GetByEmailAsync(usernameOrEmail)
activate Repo
Repo -> DB : SELECT * FROM Users\nWHERE Username=? OR Email=?
DB --> Repo : User record
Repo --> Handler : User entity
deactivate Repo

alt User Not Found
    Handler --> Controller : NotFoundException
    Controller --> ApiClient : 401 Unauthorized\n{"message": "Invalid credentials"}
    ApiClient --> AuthSvc : Throw AuthError
    AuthSvc --> Redux : Throw Error
    Redux --> Screen : state.error = "Invalid credentials"
    Screen --> User : Show error message
else User Found
    Handler -> Handler : PasswordHasher.Verify(password, user.PasswordHash)

    alt Wrong Password
        Handler --> Controller : UnauthorizedException\n("Invalid credentials")
        Controller --> ApiClient : 401 Unauthorized
        ApiClient --> AuthSvc : Throw AuthError
        AuthSvc --> Redux : Throw Error
        Redux --> Screen : state.error = "Invalid credentials"
        Screen --> User : Show error message
    else Correct Password
        Handler -> Handler : user.RecordLogin()

        Handler -> JWT : GenerateAccessToken(user)
        activate JWT
        JWT --> Handler : accessToken (JWT, 15min)
        deactivate JWT

        Handler -> JWT : GenerateRefreshToken()
        activate JWT
        JWT --> Handler : refreshToken (guid)
        deactivate JWT

        Handler -> Redis : SET refresh_token:{userId}:{tokenId} = token\n(TTL: 30 days)
        Redis --> Handler : OK

        Handler -> Repo : UpdateAsync(user)
        activate Repo
        Repo -> DB : UPDATE Users SET LastLoginAt=NOW()
        DB --> Repo : OK
        deactivate Repo

        Handler --> Controller : AuthResult\n{user, accessToken, refreshToken}
        deactivate Handler

        Controller --> ApiClient : 200 OK\n{user, accessToken, refreshToken}
        deactivate Controller

        ApiClient --> AuthSvc : AuthResult
        deactivate ApiClient
        AuthSvc --> Redux : AuthResult
        deactivate AuthSvc

        Redux -> Storage : SecureStore.setItemAsync("access_token", accessToken)
        Redux -> Storage : SecureStore.setItemAsync("refresh_token", refreshToken)
        Storage --> Redux : Stored

        Redux -> Redux : setCredentials(user, accessToken)
        Redux --> Screen : state.isAuthenticated = true
        deactivate Redux

        Screen --> User : Navigate to HomeScreen
    end
end

== Token Refresh Flow (Automatic via Interceptor) ==

note over ApiClient : When any API call returns 401 (token expired)

ApiClient -> ApiClient : Intercept 401 response
ApiClient -> ApiClient : Check if already refreshing?

alt Already Refreshing
    ApiClient -> ApiClient : Queue request in tokenRefreshQueue[]
    ApiClient -> ApiClient : Await refresh completion\nthen retry with new token
else Not Refreshing
    ApiClient -> ApiClient : isRefreshing = true

    ApiClient -> Storage : getItemAsync("refresh_token")
    Storage --> ApiClient : refreshToken

    ApiClient -> Controller : POST /api/v1/auth/refresh\n{accessToken, refreshToken}
    activate Controller

    Controller -> Handler : Send(RefreshTokenCommand)
    activate Handler

    Handler -> JWT : GetPrincipalFromToken(accessToken)
    activate JWT
    JWT --> Handler : ClaimsPrincipal (userId, etc.)
    deactivate JWT

    Handler -> Redis : GET refresh_token:{userId}:{tokenId}
    Redis --> Handler : storedToken

    alt Refresh Token Valid
        Handler -> JWT : GenerateAccessToken(user)
        activate JWT
        JWT --> Handler : newAccessToken
        deactivate JWT

        Handler -> JWT : GenerateRefreshToken()
        activate JWT
        JWT --> Handler : newRefreshToken
        deactivate JWT

        Handler -> Redis : DELETE old token\nSET new token (rotation)
        Redis --> Handler : OK

        Handler --> Controller : AuthResult\n{newAccessToken, newRefreshToken}
        deactivate Handler

        Controller --> ApiClient : 200 OK\n{tokens}
        deactivate Controller

        ApiClient -> Storage : Update stored tokens
        ApiClient -> ApiClient : isRefreshing = false
        ApiClient -> ApiClient : Retry all queued requests\nwith new access token
    else Refresh Token Invalid/Expired
        Handler --> Controller : UnauthorizedException
        Controller --> ApiClient : 401 Unauthorized
        ApiClient -> Redux : dispatch(clearAuth())
        Redux --> Screen : Navigate to LoginScreen
    end
end

@enduml
