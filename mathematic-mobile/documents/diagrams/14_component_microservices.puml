@startuml 14_Component_Microservices
title System Architecture - Microservices Component Diagram

skinparam component {
    BackgroundColor WhiteSmoke
    BorderColor DarkSlateGray
    ArrowColor DarkSlateGray
    FontSize 11
}
skinparam database {
    BackgroundColor LightBlue
    BorderColor DarkSlateGray
}
skinparam node {
    BackgroundColor LightYellow
    BorderColor DarkSlateGray
}

node "Mobile Device" {
    [React Native App\n(Expo)] as MobileApp
}

node "Docker Network" {

    node "Traefik Reverse Proxy\n(:80, :443)" as Traefik {
        [Load Balancer\n& SSL Termination] as LB
    }

    node "Auth Service\n(Port 8001, .NET 8)" as AuthNode {
        component "Controllers" as AuthCtrl {
            [AuthController]
            [UsersController]
        }
        component "Application (CQRS)" as AuthApp {
            [Commands\n(Register, Login,\nRefresh, Update)]
            [Queries\n(GetUser, Validate)]
            [ValidationBehavior\n(FluentValidation)]
        }
        component "Domain" as AuthDomain {
            [User Entity]
            [BaseEntity]
        }
        component "Infrastructure" as AuthInfra {
            [UserRepository\n(EF Core)]
            [JwtTokenGenerator]
            [PasswordHasher\n(BCrypt)]
            [RedisCache\n(Refresh Tokens)]
        }
    }

    node "Problem Service\n(Port 8002, .NET 8)" as ProbNode {
        component "Controllers" as ProbCtrl {
            [ProblemController]
        }
        component "Application (CQRS)" as ProbApp {
            [Commands\n(Create, Update,\nDelete, Upload,\nUpdateStatus)]
            [Queries\n(GetProblems,\nSearch, Stats)]
            [ValidationBehavior]
        }
        component "Domain" as ProbDomain {
            [Problem Entity]
            [ProblemHistory Entity]
            [ProblemStatus Enum]
        }
        component "Infrastructure" as ProbInfra {
            [ProblemRepository\n(EF Core)]
            [MLServiceClient\n(HttpClient + Polly)]
            [FileStorage\n(Local/Cloud)]
        }
    }

    node "ML/OCR Service\n(Port 8003, FastAPI)" as MLNode {
        component "API Layer" as MLApi {
            [OCR Router\n(/ocr/extract)]
            [Solution Router\n(/solution/solve)]
            [Health Router]
        }
        component "Application" as MLApp {
            [ExtractTextUseCase]
            [SolveProblemUseCase]
            [OCRAndSolveUseCase]
        }
        component "Infrastructure / Models" as MLModels {
            [OCRModel\n(microsoft/trocr-base)]
            [SolutionModel\n(google/flan-t5-base)]
            [ImagePreprocessor]
            [MathExpressionParser\n(SymPy)]
        }
    }

    database "MySQL\nAuth DB\n(:3307)" as AuthDB
    database "MySQL\nProblem DB\n(:3308)" as ProbDB
    database "Redis\n(:6379)\n(Refresh Tokens,\nRate Limiting)" as RedisDB

    node "Observability Stack" {
        [Prometheus\n(Metrics)] as Prometheus
        [Grafana\n(Dashboards)] as Grafana
        [Seq / ELK\n(Structured Logs)] as Logs
    }
}

' Mobile to Traefik
MobileApp --> Traefik : HTTPS REST API\n(JWT Bearer Auth)

' Traefik routing
Traefik --> AuthNode : /api/v1/auth/**
Traefik --> ProbNode : /api/v1/problems/**

' Auth Service internals
AuthCtrl --> AuthApp
AuthApp --> AuthDomain
AuthInfra --> AuthDomain
AuthInfra --> AuthDB : EF Core ORM
AuthInfra --> RedisDB : StackExchange.Redis

' Problem Service internals
ProbCtrl --> ProbApp
ProbApp --> ProbDomain
ProbInfra --> ProbDomain
ProbInfra --> ProbDB : EF Core ORM
ProbNode --> AuthNode : Validate JWT\nGET /api/v1/auth/validate

' Problem to ML communication
ProbNode --> MLNode : HTTP POST (async)\n/ocr/extract\n/solution/solve
MLNode --> ProbNode : Callback\nPOST /problems/{id}/status

' ML internals
MLApi --> MLApp
MLApp --> MLModels

' Observability
AuthNode --> Prometheus : metrics
ProbNode --> Prometheus : metrics
MLNode --> Prometheus : metrics
Prometheus --> Grafana : visualize
AuthNode --> Logs : structured logs
ProbNode --> Logs : structured logs
MLNode --> Logs : structured logs

@enduml
