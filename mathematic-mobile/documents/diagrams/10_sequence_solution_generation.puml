@startuml 10_Sequence_Solution_Generation
title Solution Generation Flow (OCR + AI Solving) - Sequence Diagram

skinparam sequenceMessageAlign center
skinparam sequence {
    ArrowColor DarkSlateGray
    ActorBorderColor DarkSlateGray
    LifeLineBorderColor DarkSlateGray
    ParticipantBorderColor DarkSlateGray
    ParticipantBackgroundColor WhiteSmoke
}

participant "MLServiceClient\n(.NET)" as MLClient
participant "OCR Router\n(FastAPI)" as OCRRouter
participant "ExtractTextUseCase\n(Python)" as OCRUseCase
participant "ImagePreprocessor\n(Python)" as ImgProc
participant "OCRModel\n(TrOCR)" as OCRModel
participant "SolutionRouter\n(FastAPI)" as SolRouter
participant "SolveProblemUseCase\n(Python)" as SolveUseCase
participant "TextPreprocessor\n(Python)" as TextProc
participant "MathExpressionParser\n(SymPy)" as MathParser
participant "SolutionModel\n(FLAN-T5)" as SolModel
participant "UpdateStatusHandler\n(.NET)" as StatusHandler
participant "ProblemRepository\n(EF Core)" as Repo
database "MySQL\n(Problem DB)" as DB
participant "solutionSlice\n(Redux)" as Redux
participant "SolutionScreen\n(React Native)" as Screen

== Phase 1: OCR Text Extraction ==

note over OCRRouter : Problem image was uploaded,\nMLServiceClient triggered OCR

OCRRouter -> OCRUseCase : execute(image_data, metadata)
activate OCRUseCase

OCRUseCase -> ImgProc : preprocess_for_ocr(image_bytes)
activate ImgProc
ImgProc -> ImgProc : Convert to PIL Image
ImgProc -> ImgProc : Convert to grayscale
ImgProc -> ImgProc : Enhance contrast (CLAHE)
ImgProc -> ImgProc : Remove noise (Gaussian blur)
ImgProc -> ImgProc : Resize to model input size
ImgProc --> OCRUseCase : Preprocessed PIL Image
deactivate ImgProc

OCRUseCase -> OCRModel : predict(preprocessed_image)
activate OCRModel
OCRModel -> OCRModel : processor.encode(image)
OCRModel -> OCRModel : model.generate(pixel_values,\nmax_length=512)
OCRModel -> OCRModel : processor.decode(generated_ids)
OCRModel -> OCRModel : calculate_confidence(outputs)
OCRModel --> OCRUseCase : OCRResult\n{extracted_text, confidence, metadata}
deactivate OCRModel

OCRUseCase --> OCRRouter : OCRResult
deactivate OCRUseCase

OCRRouter --> MLClient : 200 OK\n{extracted_text, confidence}
MLClient --> StatusHandler : OCRResult received

== Phase 2: Problem Solving ==

StatusHandler -> SolRouter : POST /api/v1/solution/solve\n{problem_text: extracted_text, problemId}
activate SolRouter

SolRouter -> SolveUseCase : execute(problem_text)
activate SolveUseCase

SolveUseCase -> TextProc : clean(problem_text)
activate TextProc
TextProc -> TextProc : Remove special chars
TextProc -> TextProc : Normalize whitespace
TextProc -> TextProc : detect_language(text)

alt Text is Vietnamese
    TextProc -> TextProc : translate_to_english(text)
end

TextProc -> TextProc : normalize_math_symbols(text)
TextProc --> SolveUseCase : cleaned_text
deactivate TextProc

SolveUseCase -> MathParser : extract_expressions(cleaned_text)
activate MathParser
MathParser -> MathParser : Identify math patterns\n(equations, formulas, etc.)
MathParser -> MathParser : to_sympy(expressions)
MathParser --> SolveUseCase : parsed_expressions[]
deactivate MathParser

alt Expression parseable by SymPy
    SolveUseCase -> MathParser : solve_algebraic(expression)
    activate MathParser
    MathParser -> MathParser : sympy.solve(expr)
    MathParser -> MathParser : sympy.simplify(solution)
    MathParser --> SolveUseCase : symbolic_solution
    deactivate MathParser
end

SolveUseCase -> SolModel : predict(cleaned_text)
activate SolModel
SolModel -> SolModel : tokenizer.encode(problem_prompt)
SolModel -> SolModel : model.generate(input_ids,\nmax_length=512, num_beams=4)
SolModel -> SolModel : tokenizer.decode(output_ids)
SolModel -> SolModel : generate_steps(output_text)
SolModel -> SolModel : calculate_confidence(outputs)
SolModel --> SolveUseCase : SolutionResult\n{solution, steps[], final_answer, confidence}
deactivate SolModel

SolveUseCase --> SolRouter : SolutionResult
deactivate SolveUseCase

SolRouter --> StatusHandler : SolutionResult
deactivate SolRouter

== Phase 3: Update Problem Status & Notify Frontend ==

StatusHandler -> Repo : GetByIdAsync(problemId)
activate Repo
Repo -> DB : SELECT * FROM Problems WHERE Id=?
DB --> Repo : Problem entity
deactivate Repo

StatusHandler -> StatusHandler : problem.SetCompleted(extractedText)
StatusHandler -> Repo : UpdateAsync(problem)
activate Repo
Repo -> DB : UPDATE Problems SET\nStatus=Completed,\nExtractedText=?,\nCompletedAt=NOW()
DB --> Repo : OK
deactivate Repo

== Phase 4: Frontend Polls & Displays Solution ==

note over Screen : Frontend polls or\nreceives push notification

Screen -> Redux : dispatch(fetchSolution(problemId))
activate Redux
Redux --> Screen : solution state updated
deactivate Redux

Screen -> Screen : Render SolutionSteps\n(with KaTeX/MathJax)

Screen -> Screen : stepNavigation.goToFirst()

note over Screen : User can navigate\nthrough solution steps\nstep-by-step

@enduml
