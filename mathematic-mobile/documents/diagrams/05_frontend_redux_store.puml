@startuml 05_Frontend_Redux_Store
title Frontend - Redux Store Architecture (Class Diagram)

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor WhiteSmoke
    BorderColor DarkSlateGray
    ArrowColor DarkSlateGray
    FontSize 11
}

package "Redux Store" {
    class RootStore {
        + auth : AuthState
        + problem : ProblemState
        + solution : SolutionState
        + user : UserState
        + app : AppState
        + bookmarks : BookmarkState
    }
}

package "Auth Slice" {
    class AuthState {
        + user : UserInfo | null
        + token : string | null
        + refreshToken : string | null
        + isAuthenticated : boolean
        + isLoading : boolean
        + error : string | null
        + lastLoginAt : string | null
    }

    class AuthSlice {
        + loginUser(credentials) : AsyncThunk
        + registerUser(data) : AsyncThunk
        + logoutUser() : AsyncThunk
        + refreshAccessToken() : AsyncThunk
        + setCredentials(user, token) : Action
        + clearAuth() : Action
        + setError(message) : Action
    }
}

package "Problem Slice" {
    class ProblemState {
        + problems : Problem[]
        + currentProblem : Problem | null
        + isSubmitting : boolean
        + isLoading : boolean
        + pagination : PaginationInfo
        + filters : ProblemFilters
        + error : string | null
    }

    class ProblemSlice {
        + fetchProblems(params) : AsyncThunk
        + createProblem(data) : AsyncThunk
        + updateProblem(id, data) : AsyncThunk
        + deleteProblem(id) : AsyncThunk
        + uploadImage(id, imageData) : AsyncThunk
        + retryProblem(id) : AsyncThunk
        + searchProblems(query) : AsyncThunk
        + setCurrentProblem(problem) : Action
        + setFilters(filters) : Action
    }

    class ProblemFilters {
        + category : string | null
        + status : string | null
        + difficulty : string | null
        + dateFrom : string | null
        + dateTo : string | null
        + searchText : string
    }
}

package "Solution Slice" {
    class SolutionState {
        + solutions : Record<string, Solution>
        + currentSolution : Solution | null
        + currentStep : number
        + isLoading : boolean
        + error : string | null
        + userRating : number | null
    }

    class SolutionSlice {
        + fetchSolution(problemId) : AsyncThunk
        + fetchSolutionByProblemId(id) : AsyncThunk
        + rateSolution(solutionId, rating, feedback) : AsyncThunk
        + setCurrentStep(step) : Action
        + nextStep() : Action
        + prevStep() : Action
        + clearSolution() : Action
    }
}

package "User Slice" {
    class UserState {
        + profile : UserProfile | null
        + stats : UserStats
        + preferences : UserPreferences
        + isLoading : boolean
        + error : string | null
    }

    class UserStats {
        + totalProblems : number
        + solvedProblems : number
        + failedProblems : number
        + streak : number
        + achievements : Achievement[]
    }

    class UserPreferences {
        + theme : "light" | "dark" | "system"
        + language : string
        + mathNotation : "standard" | "latex"
        + hintLevel : "none" | "minimal" | "full"
        + notifications : boolean
    }

    class UserSlice {
        + fetchUserProfile() : AsyncThunk
        + updateUserProfile(data) : AsyncThunk
        + fetchUserStats() : AsyncThunk
        + updatePreferences(prefs) : AsyncThunk
        + changePassword(data) : AsyncThunk
    }
}

package "App Slice" {
    class AppState {
        + isInitialized : boolean
        + isOnline : boolean
        + networkType : string
        + theme : string
        + currentRoute : string
        + globalError : AppError | null
        + errorQueue : AppError[]
        + pushToken : string | null
        + notificationPermission : boolean
        + unreadNotifications : number
        + features : AppFeatures
        + performance : PerformanceMetrics
    }

    class AppFeatures {
        + cameraEnabled : boolean
        + offlineMode : boolean
        + betaFeatures : boolean
        + analytics : boolean
    }

    class AppSlice {
        + initializeApp() : AsyncThunk
        + setOnlineStatus(isOnline) : Action
        + setTheme(theme) : Action
        + setGlobalError(error) : Action
        + clearGlobalError() : Action
        + addToErrorQueue(error) : Action
        + setPushToken(token) : Action
    }
}

package "Bookmark Slice" {
    class BookmarkState {
        + items : Bookmark[]
        + isLoading : boolean
        + error : string | null
    }

    class Bookmark {
        + id : string
        + problemId : string
        + solutionSteps : SolutionStep[]
        + confidence : number
        + bookmarkedAt : string
        + notes : string | null
        + lastViewedAt : string
    }

    class BookmarkSlice {
        + fetchBookmarks() : AsyncThunk
        + addBookmark(problemId, data) : AsyncThunk
        + removeBookmark(id) : AsyncThunk
        + updateBookmarkNotes(id, notes) : AsyncThunk
    }
}

RootStore --> AuthState : auth
RootStore --> ProblemState : problem
RootStore --> SolutionState : solution
RootStore --> UserState : user
RootStore --> AppState : app
RootStore --> BookmarkState : bookmarks

AuthState --> AuthSlice : managed by
ProblemState --> ProblemSlice : managed by
ProblemState --> ProblemFilters : contains
SolutionState --> SolutionSlice : managed by
UserState --> UserSlice : managed by
UserState --> UserStats : contains
UserState --> UserPreferences : contains
AppState --> AppSlice : managed by
AppState --> AppFeatures : contains
BookmarkState --> BookmarkSlice : managed by
BookmarkState "1" *-- "many" Bookmark : contains

@enduml
