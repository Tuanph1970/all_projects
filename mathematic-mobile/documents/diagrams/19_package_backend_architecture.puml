@startuml 19_Package_Backend_Architecture
title Backend - Clean Architecture Package Diagram

skinparam package {
    BackgroundColor #F5F5F5
    BorderColor DarkSlateGray
    ArrowColor DarkSlateGray
    FontSize 11
}
skinparam component {
    BackgroundColor WhiteSmoke
    BorderColor DarkSlateGray
}

package "Auth Service (.NET 8)" {

    package "Presentation Layer\n(AuthService.API)" <<Rectangle>> {
        [AuthController\n- POST /register\n- POST /login\n- POST /refresh\n- GET /me\n- PUT /profile\n- POST /change-password] as AuthCtrl
        [UsersController\n- GET /users/{id}\n- POST /validate] as UserCtrl
        [ExceptionHandlingMiddleware] as ExcMW
        [RequestLoggingMiddleware] as LogMW
        [RateLimitingMiddleware] as RateMW
    }

    package "Application Layer\n(AuthService.Application)" <<Rectangle>> {
        [Commands\n  RegisterCommand\n  LoginCommand\n  RefreshTokenCommand\n  UpdateProfileCommand\n  ChangePasswordCommand] as AuthCmds
        [Queries\n  GetCurrentUserQuery\n  GetUserByIdQuery\n  ValidateTokenQuery] as AuthQueries
        [Validators\n  RegisterCommandValidator\n  LoginCommandValidator] as AuthVals
        [Behaviors\n  ValidationBehavior\n  LoggingBehavior] as AuthBehaviors
        [DTOs\n  AuthResult, UserDto\n  TokenPair] as AuthDTOs
    }

    package "Domain Layer\n(AuthService.Domain)" <<Rectangle>> {
        [User Entity\n(DDD Rich Entity)] as UserEntity
        [BaseEntity\n(Guid Id, timestamps\ndomain events)] as BaseEnt
        [IUserRepository\nIJwtTokenGenerator\nIPasswordHasher\nIUnitOfWork] as AuthInterfaces
        [UserRole Enum] as RoleEnum
    }

    package "Infrastructure Layer\n(AuthService.Infrastructure)" <<Rectangle>> {
        [ApplicationDbContext\n(EF Core)] as AuthDbCtx
        [UserRepository\n(EF Core impl)] as UserRepo
        [UnitOfWork\n(transaction mgmt)] as AuthUoW
        [JwtTokenGenerator\n(System.IdentityModel)] as JwtGen
        [PasswordHasher\n(BCrypt.Net)] as PwdHasher
        [RedisCache\n(StackExchange.Redis)] as AuthRedis
        [Serilog\n(Structured Logging)] as AuthLog
    }
}

package "Problem Service (.NET 8)" {

    package "Presentation Layer\n(ProblemService.API)" <<Rectangle>> {
        [ProblemController\n- POST /problems\n- GET /problems\n- GET /problems/{id}\n- PUT /problems/{id}\n- DELETE /problems/{id}\n- POST /problems/{id}/upload\n- POST /problems/{id}/status\n- POST /problems/search\n- GET /problems/stats] as ProbCtrl
        [ExceptionHandlingMiddleware\nRequestLoggingMiddleware\nRateLimitingMiddleware] as ProbMW
    }

    package "Application Layer\n(ProblemService.Application)" <<Rectangle>> {
        [Commands\n  CreateProblemCommand\n  UpdateProblemCommand\n  DeleteProblemCommand\n  UploadImageCommand\n  UpdateProblemStatusCommand] as ProbCmds
        [Queries\n  GetUserProblemsQuery\n  GetProblemByIdQuery\n  SearchProblemsQuery\n  GetStatisticsQuery] as ProbQueries
        [Validators\n  CreateProblemCommandValidator\n  UpdateProblemCommandValidator] as ProbVals
        [Behaviors\n  ValidationBehavior\n  LoggingBehavior] as ProbBehaviors
    }

    package "Domain Layer\n(ProblemService.Domain)" <<Rectangle>> {
        [Problem Entity\n(DDD Rich Entity)] as ProbEntity
        [ProblemHistory Entity] as HistEntity
        [BaseEntity] as ProbBase
        [ProblemStatus Enum\n(Pending/Processing/\nCompleted/Failed)] as StatusEnum
        [IProblemRepository\nIProblemHistoryRepository\nIMLServiceClient\nIUnitOfWork] as ProbInterfaces
    }

    package "Infrastructure Layer\n(ProblemService.Infrastructure)" <<Rectangle>> {
        [ApplicationDbContext\n(EF Core)] as ProbDbCtx
        [ProblemRepository\n(EF Core impl)] as ProbRepo
        [ProblemHistoryRepository] as HistRepo
        [UnitOfWork] as ProbUoW
        [MLServiceClient\n(HttpClient + Polly\nretry policies)] as MLClient
        [FileStorageService\n(local/cloud)] as FileStore
        [Serilog] as ProbLog
    }
}

' Dependency arrows (outer to inner layers)
AuthCtrl --> AuthCmds : Send() via MediatR
AuthCtrl --> AuthQueries : Send() via MediatR
AuthCmds --> AuthVals : pipeline
AuthCmds --> AuthBehaviors : pipeline
AuthCmds --> UserEntity : create/modify
AuthCmds --> AuthInterfaces : call
AuthInterfaces <|.. UserRepo : implements
AuthInterfaces <|.. JwtGen : implements
AuthInterfaces <|.. PwdHasher : implements
AuthInterfaces <|.. AuthUoW : implements
AuthDbCtx --> UserRepo : used by
AuthUoW --> AuthDbCtx : wraps

ProbCtrl --> ProbCmds : Send() via MediatR
ProbCtrl --> ProbQueries : Send() via MediatR
ProbCmds --> ProbVals : pipeline
ProbCmds --> ProbBehaviors : pipeline
ProbCmds --> ProbEntity : create/modify
ProbCmds --> ProbInterfaces : call
ProbInterfaces <|.. ProbRepo : implements
ProbInterfaces <|.. HistRepo : implements
ProbInterfaces <|.. MLClient : implements
ProbInterfaces <|.. ProbUoW : implements
ProbDbCtx --> ProbRepo : used by
ProbUoW --> ProbDbCtx : wraps

note bottom of AuthCtrl
  Pattern: Thin Controllers
  Only dependency: ISender (MediatR)
  All logic in Application Layer
end note

note bottom of ProbCtrl
  Clean Architecture Rules:
  Domain has no dependencies
  Application depends on Domain
  Infrastructure implements Interfaces
  Presentation depends on Application
end note

@enduml
