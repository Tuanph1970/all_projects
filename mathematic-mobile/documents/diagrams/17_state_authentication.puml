@startuml 17_State_Authentication
title Authentication States - State Diagram

skinparam state {
    BackgroundColor WhiteSmoke
    BorderColor DarkSlateGray
    ArrowColor DarkSlateGray
    FontSize 12
}

[*] --> AppInitializing : App launched

state AppInitializing {
    AppInitializing : initializeApp() thunk runs
    AppInitializing : Check SecureStore\nfor stored tokens
}

AppInitializing --> Unauthenticated : No stored token\nor token invalid
AppInitializing --> Authenticated : Valid stored token\n(restored from persist)
AppInitializing --> TokenExpired : Access token expired\nbut refresh token valid

state Unauthenticated {
    Unauthenticated : No JWT token
    Unauthenticated : Show Auth Navigator\n(Welcome/Login/Register)
    Unauthenticated : No API calls allowed
}

state Authenticating {
    Authenticating : Login or Register\nrequest in flight
    Authenticating : isLoading = true
    Authenticating : Show loading indicator
}

state Authenticated {
    Authenticated : Valid JWT access token\n(15 min expiry)
    Authenticated : Valid refresh token\n(30 days expiry)
    Authenticated : user, token in Redux state
    Authenticated : token persisted in SecureStore

    state "Making API Call" as APICall {
        APICall : Request with Bearer token
    }

    state "Token Valid" as TokenValid {
    }

    state "401 Received" as Recv401 {
        Recv401 : API returned 401
        Recv401 : Interceptor captures
    }

    [*] --> APICall
    APICall --> TokenValid : 200 OK response
    APICall --> Recv401 : 401 Unauthorized
    TokenValid --> [*]
    Recv401 --> [*] : (trigger refresh)
}

state TokenExpired {
    TokenExpired : Access token expired
    TokenExpired : Refresh token still valid
    TokenExpired : isRefreshing = true in ApiClient
}

state RefreshingToken {
    RefreshingToken : POST /auth/refresh\ncalled automatically
    RefreshingToken : Queuing other requests
    RefreshingToken : Rotating refresh token\nin Redis
}

state LoggingOut {
    LoggingOut : logoutUser() thunk runs
    LoggingOut : DELETE /auth/refresh (invalidate token)
    LoggingOut : Clear SecureStore
    LoggingOut : Redux state.auth = initial
}

' Transitions
Unauthenticated --> Authenticating : loginUser() or\nregisterUser() dispatched
Authenticating --> Authenticated : Success\n(credentials set)
Authenticating --> Unauthenticated : Failure\n(invalid credentials or\nconflict error)

Authenticated --> TokenExpired : Access token\nexpires (15 min)
Authenticated --> LoggingOut : logoutUser() dispatched

TokenExpired --> RefreshingToken : refreshAccessToken()\ncalled by interceptor
RefreshingToken --> Authenticated : New tokens received\n(token rotation success)
RefreshingToken --> Unauthenticated : Refresh token expired\nor invalid (>30 days)

LoggingOut --> Unauthenticated : Cleanup complete

Authenticated --> Unauthenticated : Account deactivated\nor 401 (token blacklisted)

note right of Authenticated
  **Persisted via redux-persist:**
  - auth.user
  - auth.token
  - auth.refreshToken
  - auth.isAuthenticated
  Stored in Expo SecureStore
end note

note right of RefreshingToken
  **Interceptor behavior:**
  1. Capture 401 response
  2. Queue concurrent requests
  3. POST /auth/refresh
  4. On success: retry all queued\n   requests with new token
  5. On failure: navigate to Login
end note

@enduml
