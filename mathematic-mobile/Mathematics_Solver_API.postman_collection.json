{
  "info": {
    "name": "Mathematics Solver API",
    "description": "Complete API collection for Mathematics Mobile Application - MVP Testing\n\n## Features:\n- User Authentication (Register, Login)\n- Problem Management (Submit, List, View, Delete, Retry)\n- Automated token management\n- Pre-request scripts for testing\n\n## Setup:\n1. Import this collection into Postman\n2. Import the environment file (or create one with base_url variable)\n3. Run requests in order (Register → Login → Submit Problem → etc.)\n\n## Environment Variables:\n- `base_url`: http://localhost:8001/api\n- `auth_token`: Auto-populated after login\n- `problem_id`: Auto-populated after problem submission",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test response status",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Parse response",
                  "var jsonData = pm.response.json();",
                  "",
                  "// Test response structure",
                  "pm.test(\"Response has token\", function () {",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "});",
                  "",
                  "pm.test(\"Response has user data\", function () {",
                  "    pm.expect(jsonData).to.have.property('user');",
                  "    pm.expect(jsonData.user).to.have.property('username');",
                  "    pm.expect(jsonData.user).to.have.property('email');",
                  "});",
                  "",
                  "// Save token to environment",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"auth_token\", jsonData.token);",
                  "    console.log(\"✅ Auth token saved:\", jsonData.token.substring(0, 20) + \"...\");",
                  "}",
                  "",
                  "// Save user ID",
                  "if (jsonData.user && jsonData.user.id) {",
                  "    pm.environment.set(\"user_id\", jsonData.user.id);",
                  "    console.log(\"✅ User ID saved:\", jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Test123!\",\n  \"confirmPassword\": \"Test123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Register a new user account.\n\n**Request Body:**\n- username: 3-50 chars, alphanumeric + underscore\n- email: Valid email address\n- password: Min 6 chars, must contain uppercase, lowercase, and digit\n- confirmPassword: Must match password\n\n**Response:**\n- token: JWT authentication token\n- user: User details"
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test response status",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Parse response",
                  "var jsonData = pm.response.json();",
                  "",
                  "// Test response structure",
                  "pm.test(\"Response has token\", function () {",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "});",
                  "",
                  "pm.test(\"Response has user data\", function () {",
                  "    pm.expect(jsonData).to.have.property('user');",
                  "});",
                  "",
                  "// Save token to environment",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"auth_token\", jsonData.token);",
                  "    console.log(\"✅ Auth token saved:\", jsonData.token.substring(0, 20) + \"...\");",
                  "}",
                  "",
                  "// Save user ID",
                  "if (jsonData.user && jsonData.user.id) {",
                  "    pm.environment.set(\"user_id\", jsonData.user.id);",
                  "    console.log(\"✅ User ID saved:\", jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"Test123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login with existing user credentials.\n\n**Request Body:**\n- username: Your username\n- password: Your password\n\n**Response:**\n- token: JWT authentication token (valid for 60 minutes)\n- user: User details"
          },
          "response": []
        }
      ],
      "description": "User authentication endpoints for registration and login."
    },
    {
      "name": "Problems",
      "item": [
        {
          "name": "Submit Problem",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test response status",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Parse response",
                  "var jsonData = pm.response.json();",
                  "",
                  "// Test response structure",
                  "pm.test(\"Response has success flag\", function () {",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"Response has problem data\", function () {",
                  "    pm.expect(jsonData).to.have.property('problem');",
                  "    pm.expect(jsonData.problem).to.have.property('id');",
                  "    pm.expect(jsonData.problem).to.have.property('imageUrl');",
                  "    pm.expect(jsonData.problem).to.have.property('category');",
                  "    pm.expect(jsonData.problem).to.have.property('status');",
                  "});",
                  "",
                  "// Save problem ID for future requests",
                  "if (jsonData.problem && jsonData.problem.id) {",
                  "    pm.environment.set(\"problem_id\", jsonData.problem.id);",
                  "    console.log(\"✅ Problem ID saved:\", jsonData.problem.id);",
                  "}",
                  "",
                  "// Check if solution is available",
                  "if (jsonData.problem.solution) {",
                  "    pm.test(\"Solution is available\", function () {",
                  "        pm.expect(jsonData.problem.solution).to.have.property('steps');",
                  "        pm.expect(jsonData.problem.solution).to.have.property('confidence');",
                  "    });",
                  "    console.log(\"✅ Solution generated with\", jsonData.problem.solution.steps.length, \"steps\");",
                  "    console.log(\"   Confidence:\", jsonData.problem.solution.confidence);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "ImageFile",
                  "type": "file",
                  "src": [],
                  "description": "Image file containing math problem (JPG, PNG, BMP - max 10MB)"
                },
                {
                  "key": "Category",
                  "value": "Algebra",
                  "type": "text",
                  "description": "Problem category (e.g., Algebra, Geometry, Calculus)"
                },
                {
                  "key": "Description",
                  "value": "Solve for x",
                  "type": "text",
                  "description": "Optional description or context"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/problem",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "problem"
              ]
            },
            "description": "Submit a new math problem for solving.\n\n**Form Data:**\n- ImageFile: Image file (required, max 10MB)\n- Category: Problem category (required, max 50 chars)\n- Description: Optional description (max 500 chars)\n\n**Process:**\n1. Image uploaded to server\n2. Problem created (status: Pending)\n3. ML service called for OCR + solving\n4. Solution generated (if successful)\n5. Problem status updated to Completed/Failed\n\n**Response:**\n- success: Boolean indicating success\n- message: Status message\n- problem: Problem object with solution (if available)"
          },
          "response": []
        },
        {
          "name": "Get User Problems",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test response status",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Parse response",
                  "var jsonData = pm.response.json();",
                  "",
                  "// Test pagination structure",
                  "pm.test(\"Response has pagination data\", function () {",
                  "    pm.expect(jsonData).to.have.property('items');",
                  "    pm.expect(jsonData).to.have.property('page');",
                  "    pm.expect(jsonData).to.have.property('limit');",
                  "    pm.expect(jsonData).to.have.property('totalCount');",
                  "    pm.expect(jsonData).to.have.property('totalPages');",
                  "});",
                  "",
                  "// Test items structure",
                  "pm.test(\"Items is an array\", function () {",
                  "    pm.expect(jsonData.items).to.be.an('array');",
                  "});",
                  "",
                  "// Log results",
                  "console.log(\"📊 Total problems:\", jsonData.totalCount);",
                  "console.log(\"📄 Current page:\", jsonData.page, \"of\", jsonData.totalPages);",
                  "console.log(\"📝 Problems in this page:\", jsonData.items.length);",
                  "",
                  "// Save first problem ID if available",
                  "if (jsonData.items.length > 0) {",
                  "    pm.environment.set(\"problem_id\", jsonData.items[0].id);",
                  "    console.log(\"✅ First problem ID saved:\", jsonData.items[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/problem?page=1&limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "problem"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (default: 20, max: 100)"
                },
                {
                  "key": "category",
                  "value": "Algebra",
                  "description": "Filter by category",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "Completed",
                  "description": "Filter by status (Pending, Processing, Completed, Failed)",
                  "disabled": true
                },
                {
                  "key": "searchQuery",
                  "value": "solve",
                  "description": "Search in description or category",
                  "disabled": true
                }
              ]
            },
            "description": "Get paginated list of user's problems with optional filters.\n\n**Query Parameters:**\n- page: Page number (default: 1)\n- limit: Items per page (default: 20, max: 100)\n- category: Filter by category (optional)\n- status: Filter by status (optional)\n- searchQuery: Search term (optional)\n\n**Response:**\n- items: Array of problem objects\n- page: Current page number\n- limit: Items per page\n- totalCount: Total number of problems\n- totalPages: Total number of pages\n- hasNextPage: Boolean\n- hasPreviousPage: Boolean"
          },
          "response": []
        },
        {
          "name": "Get Problem By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test response status",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Parse response",
                  "var jsonData = pm.response.json();",
                  "",
                  "// Test problem structure",
                  "pm.test(\"Response has problem data\", function () {",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('imageUrl');",
                  "    pm.expect(jsonData).to.have.property('category');",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "});",
                  "",
                  "// Check solution",
                  "if (jsonData.solution) {",
                  "    pm.test(\"Solution is available\", function () {",
                  "        pm.expect(jsonData.solution).to.have.property('steps');",
                  "        pm.expect(jsonData.solution).to.have.property('confidence');",
                  "    });",
                  "    ",
                  "    console.log(\"✅ Problem Status:\", jsonData.status);",
                  "    console.log(\"📊 Solution Steps:\", jsonData.solution.steps.length);",
                  "    console.log(\"🎯 Confidence:\", jsonData.solution.confidence);",
                  "} else {",
                  "    console.log(\"⏳ Problem Status:\", jsonData.status);",
                  "    console.log(\"ℹ️ Solution not yet available\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/problem/{{problem_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "problem",
                "{{problem_id}}"
              ]
            },
            "description": "Get details of a specific problem by ID.\n\n**Path Parameters:**\n- problemId: GUID of the problem\n\n**Response:**\n- Full problem object including:\n  - id, userId, imageUrl, category, status, description\n  - createdAt, updatedAt\n  - solution: Solution object (if available)\n\n**Error Responses:**\n- 404: Problem not found\n- 401: Unauthorized (not the problem owner)"
          },
          "response": []
        },
        {
          "name": "Delete Problem",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test response status",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Parse response",
                  "var jsonData = pm.response.json();",
                  "",
                  "// Test response structure",
                  "pm.test(\"Response has success message\", function () {",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "});",
                  "",
                  "console.log(\"✅ Problem deleted successfully\");",
                  "console.log(\"📝 Message:\", jsonData.message);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/problem/{{problem_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "problem",
                "{{problem_id}}"
              ]
            },
            "description": "Delete a problem.\n\n**Path Parameters:**\n- problemId: GUID of the problem to delete\n\n**Process:**\n1. Verify ownership\n2. Delete image file from storage\n3. Delete problem from database (cascades to solution)\n\n**Response:**\n- message: Success message\n\n**Error Responses:**\n- 404: Problem not found\n- 401: Unauthorized (not the problem owner)"
          },
          "response": []
        },
        {
          "name": "Retry Problem",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test response status",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Parse response",
                  "var jsonData = pm.response.json();",
                  "",
                  "// Test response structure",
                  "pm.test(\"Response has success flag\", function () {",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "});",
                  "",
                  "pm.test(\"Response has problem data\", function () {",
                  "    pm.expect(jsonData).to.have.property('problem');",
                  "});",
                  "",
                  "// Check if retry was successful",
                  "if (jsonData.success) {",
                  "    console.log(\"✅ Retry successful\");",
                  "    console.log(\"📊 Problem Status:\", jsonData.problem.status);",
                  "    ",
                  "    if (jsonData.problem.solution) {",
                  "        console.log(\"✅ New solution generated\");",
                  "        console.log(\"   Steps:\", jsonData.problem.solution.steps.length);",
                  "        console.log(\"   Confidence:\", jsonData.problem.solution.confidence);",
                  "    }",
                  "} else {",
                  "    console.log(\"❌ Retry failed:\", jsonData.message);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/problem/{{problem_id}}/retry",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "problem",
                "{{problem_id}}",
                "retry"
              ]
            },
            "description": "Retry solving a failed or incomplete problem.\n\n**Path Parameters:**\n- problemId: GUID of the problem to retry\n\n**Process:**\n1. Verify ownership\n2. Mark problem as Processing\n3. Call ML service again\n4. Update solution if successful\n5. Mark as Completed or Failed\n\n**Use Cases:**\n- Problem failed to solve initially\n- ML service was unavailable\n- Want to try solving with updated ML model\n\n**Response:**\n- success: Boolean\n- message: Status message\n- problem: Updated problem with new solution attempt\n\n**Error Responses:**\n- 404: Problem not found\n- 401: Unauthorized (not the problem owner)"
          },
          "response": []
        }
      ],
      "description": "Problem management endpoints for submitting, viewing, and managing math problems.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{auth_token}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "API Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "console.log(\"✅ API is healthy and responding\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/../health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "..",
                "health"
              ]
            },
            "description": "Check if the API is running and healthy.\n\nNote: This endpoint may not be implemented yet. Use this to verify the backend is running."
          },
          "response": []
        }
      ],
      "description": "Health check endpoint to verify API availability."
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global pre-request script",
          "console.log(\"🚀 Request:\", pm.info.requestName);",
          "",
          "// Check if auth token exists for protected endpoints",
          "const isAuthEndpoint = pm.info.requestName.includes('Login') || pm.info.requestName.includes('Register');",
          "",
          "if (!isAuthEndpoint && !pm.environment.get('auth_token')) {",
          "    console.warn('⚠️ No auth token found. Please login first.');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test script",
          "const responseTime = pm.response.responseTime;",
          "console.log(\"⏱️ Response time:\", responseTime, \"ms\");",
          "",
          "if (responseTime > 5000) {",
          "    console.warn(\"⚠️ Slow response (>5s)\");",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8001/api",
      "type": "string"
    }
  ]
}
