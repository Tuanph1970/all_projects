import apiClient, { handleApiResponse, handleApiError } from './apiClient';\n\nclass ProblemService {\n  // Submit a new problem\n  async submitProblem({ imageUri, category, description }) {\n    try {\n      const formData = new FormData();\n      \n      // Add image file\n      if (imageUri) {\n        const filename = imageUri.split('/').pop();\n        const match = /\\.([\\w\\d_-]+)$/i.exec(filename);\n        const type = match ? `image/${match[1]}` : 'image/jpeg';\n        \n        formData.append('image', {\n          uri: imageUri,\n          name: filename,\n          type,\n        });\n      }\n      \n      // Add other data\n      if (category) {\n        formData.append('category', category);\n      }\n      if (description) {\n        formData.append('description', description);\n      }\n      \n      const response = await apiClient.post('/problems', formData, {\n        headers: {\n          'Content-Type': 'multipart/form-data',\n        },\n        timeout: 30000, // 30 seconds for image upload\n      });\n      \n      return handleApiResponse(response);\n    } catch (error) {\n      handleApiError(error);\n    }\n  }\n\n  // Get user's problems\n  async getUserProblems({ page = 1, limit = 10, category, status } = {}) {\n    try {\n      const params = {\n        page,\n        limit,\n      };\n      \n      if (category) {\n        params.category = category;\n      }\n      if (status) {\n        params.status = status;\n      }\n      \n      const response = await apiClient.get('/problems', { params });\n      \n      return handleApiResponse(response);\n    } catch (error) {\n      handleApiError(error);\n    }\n  }\n\n  // Get problem by ID\n  async getProblemById(problemId) {\n    try {\n      const response = await apiClient.get(`/problems/${problemId}`);\n      \n      return handleApiResponse(response);\n    } catch (error) {\n      handleApiError(error);\n    }\n  }\n\n  // Update problem\n  async updateProblem(problemId, updates) {\n    try {\n      const response = await apiClient.put(`/problems/${problemId}`, updates);\n      \n      return handleApiResponse(response);\n    } catch (error) {\n      handleApiError(error);\n    }\n  }\n\n  // Delete problem\n  async deleteProblem(problemId) {\n    try {\n      const response = await apiClient.delete(`/problems/${problemId}`);\n      \n      return handleApiResponse(response);\n    } catch (error) {\n      handleApiError(error);\n    }\n  }\n\n  // Search problems\n  async searchProblems({ query, category, dateFrom, dateTo, page = 1, limit = 10 } = {}) {\n    try {\n      const params = {\n        page,\n        limit,\n      };\n      \n      if (query) {\n        params.q = query;\n      }\n      if (category) {\n        params.category = category;\n      }\n      if (dateFrom) {\n        params.dateFrom = dateFrom;\n      }\n      if (dateTo) {\n        params.dateTo = dateTo;\n      }\n      \n      const response = await apiClient.get('/problems/search', { params });\n      \n      return handleApiResponse(response);\n    } catch (error) {\n      handleApiError(error);\n    }\n  }\n\n  // Get problem categories\n  async getCategories() {\n    try {\n      const response = await apiClient.get('/problems/categories');\n      \n      return handleApiResponse(response);\n    } catch (error) {\n      handleApiError(error);\n    }\n  }\n\n  // Get problem statistics\n  async getProblemStats() {\n    try {\n      const response = await apiClient.get('/problems/stats');\n      \n      return handleApiResponse(response);\n    } catch (error) {\n      handleApiError(error);\n    }\n  }\n\n  // Report problem\n  async reportProblem(problemId, reason, description) {\n    try {\n      const response = await apiClient.post(`/problems/${problemId}/report`, {\n        reason,\n        description,\n      });\n      \n      return handleApiResponse(response);\n    } catch (error) {\n      handleApiError(error);\n    }\n  }\n\n  // Retry solving problem\n  async retrySolution(problemId) {\n    try {\n      const response = await apiClient.post(`/problems/${problemId}/retry`);\n      \n      return handleApiResponse(response);\n    } catch (error) {\n      handleApiError(error);\n    }\n  }\n\n  // Get problem solving status\n  async getProblemStatus(problemId) {\n    try {\n      const response = await apiClient.get(`/problems/${problemId}/status`);\n      \n      return handleApiResponse(response);\n    } catch (error) {\n      handleApiError(error);\n    }\n  }\n}\n\nexport const problemService = new ProblemService();