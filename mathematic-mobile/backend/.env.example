# =============================================================================
# MATHEMATIC MOBILE - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env: cp .env.example .env
# For Docker deployment, use these settings as-is
# =============================================================================

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
ASPNETCORE_ENVIRONMENT=Production
LOG_LEVEL=Information

# =============================================================================
# DATABASE CONFIGURATION - MySQL
# =============================================================================
# For Docker deployment: use container name "db"
# For local MySQL: use "localhost"
DB_SERVER=db
DB_PORT=3306
DB_NAME=MathematicsSolverDb
DB_USER=mathematic_user
DB_PASSWORD=Mysql_2025
MYSQL_ROOT_PASSWORD=Mysql_2025

# External port for database access from host machine
MATH_DB_PORT=3310

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# For Docker deployment: use container name "redis"
# For local Redis: use "localhost"
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# External port for Redis access from host machine
MATH_REDIS_PORT=6380

# =============================================================================
# API CONFIGURATION
# =============================================================================
# .NET Core API port (internal container port)
API_PORT=8001

# External API port for host access
MATH_API_PORT=8003

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://192.168.1.100:8081

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=.jpg,.jpeg,.png,.bmp

# =============================================================================
# PROCESSING CONFIGURATION
# =============================================================================
PROCESSING_TIMEOUT=30

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
JWT_SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars

# =============================================================================
# MICROSERVICES CONFIGURATION
# =============================================================================
# Traefik API Gateway
GATEWAY_PORT=8003
TRAEFIK_DASHBOARD_PORT=8083

# Internal Service Token (for inter-service communication)
INTERNAL_SERVICE_TOKEN=internal-service-token-change-in-production

# AI API Keys (Optional - for advanced math solving)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# =============================================================================
# PORT SUMMARY (for reference)
# =============================================================================
# MONOLITH MODE:
#   .NET API:     8003 (external) / 8001 (internal)
#   MySQL:        3310 (external) / 3306 (internal)
#   Redis:        6380 (external) / 6379 (internal)
#
# MICROSERVICES MODE:
#   Traefik:      8003 (API Gateway) / 8083 (Dashboard)
#   Auth:         8001 (internal via Traefik)
#   Problem:      8002 (internal via Traefik)
#   Solution:     8003 (internal via Traefik)
#   MySQL:        3310 (external) / 3306 (internal)
#   Redis:        6380 (external) / 6379 (internal)
# =============================================================================
