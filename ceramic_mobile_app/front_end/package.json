{
  "name": "CeramicMarketplace",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node start-expo.js",
    "start:original": "expo start",
    "android": "node start-expo.js && expo start --android",
    "ios": "node start-expo.js && expo start --ios",
    "web": "node start-expo.js && expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:view": "jest --coverage && open coverage/lcov-report/index.html",
    "test:unit": "jest --testPathPattern='(/__tests__/|\\.(test|spec))\\.(js|jsx|ts|tsx)$' --testPathIgnorePatterns='/integration/'",
    "test:integration": "jest --testPathPattern='integration\\.test\\.(js|jsx|ts|tsx)$'",
    "test:all": "jest --coverage && npm run test:integration",
    "test:debug": "jest --detectOpenHandles --verbose",
    "test:update": "jest --updateSnapshot",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/push-notification-ios": "^1.11.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/drawer": "^6.6.6",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@reduxjs/toolkit": "^2.0.1",
    "axios": "^1.6.2",
    "cross-spawn": "^7.0.6",
    "expo": "~54.0.0",
    "expo-av": "~16.0.0",
    "expo-camera": "~17.0.0",
    "expo-font": "~14.0.0",
    "expo-image-picker": "~17.0.0",
    "expo-linear-gradient": "~15.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.0",
    "glob": "^7.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.48.2",
    "react-native": "0.81.4",
    "react-native-elements": "^3.4.3",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-image-crop-picker": "^0.40.3",
    "react-native-keychain": "^8.1.3",
    "react-native-modal": "^13.0.1",
    "react-native-paper": "^5.11.6",
    "react-native-push-notification": "^8.1.1",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.1.7",
    "react-native-vector-icons": "^10.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.5.1",
    "react-redux": "^9.0.4",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/cli": "~0.22.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "detox": "^20.46.0",
    "eslint": "^8.50.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "19.1.0",
    "redux-mock-store": "^1.5.5",
    "redux-thunk": "^3.1.0"
  },
  "private": true,
  "detox": {
    "test-runner": "jest",
    "runner-config": "../mobile_automation_test/e2e/jest.config.js"
  }
}
