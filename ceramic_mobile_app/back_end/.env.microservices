# =============================================================================
# MICROSERVICES ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env when using docker-compose.microservices.yml
# Usage: cp .env.microservices .env && docker-compose -f docker-compose.microservices.yml up -d

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Use host.docker.internal to connect to MySQL on host machine
# For Docker MySQL, change to: DB_HOST=db
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=ceramic_marketplace
DB_USER=ceramic_user
DB_PASSWORD=Mysql_2025
DB_ROOT_PASSWORD=Mysql_2025#

# Database Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# =============================================================================
# REDIS CACHE CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# Cache TTL Settings (in seconds)
CACHE_DEFAULT_TTL=300
CACHE_PRODUCT_TTL=600
CACHE_USER_TTL=300
CACHE_SESSION_TTL=86400

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# IMPORTANT: Change these in production!
SECRET_KEY=your-super-secret-key-change-this-in-production-use-64-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# =============================================================================
# MICROSERVICES PORTS
# =============================================================================
AUTH_SERVICE_PORT=8001
PRODUCT_SERVICE_PORT=8002
ORDER_SERVICE_PORT=8003
CHAT_SERVICE_PORT=8004
SELLER_SERVICE_PORT=8005

# =============================================================================
# INTER-SERVICE COMMUNICATION
# =============================================================================
AUTH_SERVICE_URL=http://auth-service:8001
PRODUCT_SERVICE_URL=http://product-service:8002
ORDER_SERVICE_URL=http://order-service:8003
CHAT_SERVICE_URL=http://chat-service:8004
SELLER_SERVICE_URL=http://seller-service:8005

# Service Timeout (milliseconds)
SERVICE_TIMEOUT=5000
SERVICE_RETRY_ATTEMPTS=3

# =============================================================================
# TRAEFIK API GATEWAY CONFIGURATION
# =============================================================================
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# Domain Configuration (for production)
DOMAIN=localhost
TRAEFIK_DASHBOARD_DOMAIN=traefik.localhost

# SSL/TLS Configuration
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_ACME_STORAGE=/etc/traefik/acme/acme.json

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=1m
RATE_LIMIT_BURST=50

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-domain.com
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_DOCUMENT_TYPES=application/pdf

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=Ceramic Marketplace
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=false

# Firebase (for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# =============================================================================
# PAYMENT CONFIGURATION
# =============================================================================
# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# VNPay (for Vietnam)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Sentry Error Tracking
SENTRY_DSN=

# Log Configuration
LOG_FORMAT=json
LOG_OUTPUT=stdout
ENABLE_ACCESS_LOG=true

# Health Check
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s

# =============================================================================
# DOCKER NETWORK CONFIGURATION
# =============================================================================
NETWORK_SUBNET=172.21.0.0/16
COMPOSE_PROJECT_NAME=ceramic_microservices

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================
# Uncomment for development
# ENVIRONMENT=development
# DEBUG=true
# LOG_LEVEL=DEBUG
# ALLOWED_ORIGINS=*
