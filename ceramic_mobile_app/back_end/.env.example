# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update with your actual values
# For development: Set ENVIRONMENT=development
# For production: Set ENVIRONMENT=production

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
ENVIRONMENT=production
DEBUG=false

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MySQL Database Settings
DB_HOST=db
DB_PORT=3306
DB_NAME=ceramic_marketplace
DB_USER=ceramic_user
DB_PASSWORD=change_this_secure_password_in_production
DB_ROOT_PASSWORD=change_this_root_password_in_production

# External port for database (use only in development)
# Set to empty in production to prevent exposing MySQL port
DB_EXTERNAL_PORT=3308

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_a_secure_random_string_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_PORT=8002
API_BASE_URL=http://localhost:8002
FRONTEND_URL=http://localhost:3000

# CORS Configuration (comma-separated list of allowed origins)
# For production: Set specific domains, e.g., https://yourdomain.com,https://www.yourdomain.com
# For development: Use * to allow all origins
ALLOWED_ORIGINS=*

# Upload Configuration (in bytes)
MAX_UPLOAD_SIZE=10485760

# =============================================================================
# NGINX CONFIGURATION
# =============================================================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
# SMTP Server Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@ceramicmarketplace.com
SMTP_FROM_NAME=Ceramic Marketplace
SMTP_USE_TLS=true

# =============================================================================
# DEVELOPMENT vs PRODUCTION SETTINGS
# =============================================================================

# For DEVELOPMENT:
# - Uncomment the volume mount in docker-compose.yml: - ./app:/app/app
# - Set ENVIRONMENT=development
# - Set DEBUG=true
# - Use DB_EXTERNAL_PORT to access MySQL directly
# - Set ALLOWED_ORIGINS=*

# For PRODUCTION:
# - Keep volume mount commented in docker-compose.yml
# - Set ENVIRONMENT=production
# - Set DEBUG=false
# - Remove or leave DB_EXTERNAL_PORT empty to not expose MySQL
# - Set specific ALLOWED_ORIGINS domains
# - Use strong SECRET_KEY, DB_PASSWORD, and DB_ROOT_PASSWORD
# - Configure SSL certificates in nginx/ssl/

# =============================================================================
# QUICK START COMMANDS
# =============================================================================

# Development:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your settings
# 3. Start services: docker-compose up -d
# 4. View logs: docker-compose logs -f

# Production:
# 1. Copy to server: scp -r . user@server:/path/to/app
# 2. SSH to server: ssh user@server
# 3. Navigate: cd /path/to/app
# 4. Edit .env with production values
# 5. Start: docker-compose up -d
# 6. Monitor: docker-compose ps

# =============================================================================
# SECURITY NOTES
# =============================================================================
# IMPORTANT:
# - Never commit .env file to version control
# - Always use strong passwords in production
# - Rotate SECRET_KEY regularly
# - Use app-specific passwords for email (not your actual password)
# - Enable firewall rules to restrict database access
# - Keep this .env.example file updated as reference
