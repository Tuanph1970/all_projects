# =============================================================================
# CERAMIC MOBILE APP - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env: cp .env.example .env
# For Docker deployment, use these settings as-is
# =============================================================================

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
ENVIRONMENT=production
DEBUG=false

# =============================================================================
# DATABASE CONFIGURATION - MySQL
# =============================================================================
# For Docker deployment: use container name "db"
# For local MySQL: use "localhost" or "host.docker.internal"
DB_HOST=db
DB_PORT=3306
DB_NAME=ceramic_marketplace
DB_USER=ceramic_user
DB_PASSWORD=Mysql_2025
DB_ROOT_PASSWORD=Mysql_2025

# External port for database access from host machine
DB_EXTERNAL_PORT=3308

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# For Docker deployment: use container name "redis"
# For local Redis: use "localhost" or "host.docker.internal"
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_PORT=8002
API_BASE_URL=http://localhost:8002
FRONTEND_URL=http://localhost:3000

# CORS Configuration
ALLOWED_ORIGINS=*

# Upload Configuration (bytes)
MAX_UPLOAD_SIZE=10485760

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Generate secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_a_secure_random_string_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# NGINX CONFIGURATION
# =============================================================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@ceramicmarketplace.com
SMTP_FROM_NAME=Ceramic Marketplace
SMTP_USE_TLS=true

# =============================================================================
# PORT SUMMARY (for reference)
# =============================================================================
# API:      8002 (direct) or 80/443 (via nginx)
# MySQL:    3308 (external) / 3306 (internal)
# Redis:    6379
# Nginx:    80 (HTTP), 443 (HTTPS), 8082 (alternate HTTP)
# =============================================================================
