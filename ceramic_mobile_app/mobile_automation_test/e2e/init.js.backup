const detox = require('detox');
const adapter = require('detox/runners/jest/adapter');
const specReporter = require('detox/runners/jest/specReporter');
const config = require('../.detoxrc');

// Set E2E mode flag
global.__E2E__ = true;

// Set the default timeout
jest.setTimeout(120000);
jasmine.getEnv().addReporter(adapter);
jasmine.getEnv().addReporter(specReporter);

beforeAll(async () => {
  // Initialize Detox with LAX idle policy to handle animations and network calls
  await detox.init(config, {
    launchApp: false, // Don't launch here, let individual tests control it
    initGlobals: true
  });

  // Configure Detox to be more lenient with synchronization
  // This helps when app has continuous animations or network activity
  try {
    await device.setURLBlacklist(['.*']); // Blacklist all network requests from idleness detection
    console.log('Detox: Network requests blacklisted from idleness detection');
  } catch (e) {
    console.log('Detox: Could not set URL blacklist:', e.message);
  }

  // Disable synchronization globally - tests will handle it individually if needed
  await device.disableSynchronization();
  console.log('Detox: Synchronization disabled globally');
});

beforeEach(async () => {
  await adapter.beforeEach();
});

afterAll(async () => {
  await adapter.afterAll();
  await detox.cleanup();
});
