{
  "name": "ceramic-mobile-automation-tests",
  "version": "1.0.0",
  "description": "E2E automation tests for Ceramic Marketplace mobile app",
  "main": "index.js",
  "scripts": {
    "test": "detox test --configuration ios.sim.debug",
    "test:unit": "jest --config jest.config.unit.js",
    "test:unit:watch": "jest --config jest.config.unit.js --watch",
    "test:unit:coverage": "jest --config jest.config.unit.js --coverage",
    "test:android": "detox test --configuration android.emu.debug",
    "test:ios": "detox test --configuration ios.sim.debug",
    "build:android": "detox build --configuration android.emu.debug",
    "build:ios": "detox build --configuration ios.sim.debug",
    "test:auth": "detox test e2e/auth --configuration ios.sim.debug",
    "test:auth:android": "detox test e2e/auth --configuration android.emu.debug",
    "test:device:ios": "detox test --configuration ios.device.debug",
    "test:device:android": "detox test --configuration android.device.debug",
    "build:device:ios": "detox build --configuration ios.device.debug",
    "build:device:android": "detox build --configuration android.device.debug",
    "test:screenshots": "detox test --take-screenshots all --configuration ios.sim.debug",
    "test:debug": "detox test --loglevel trace --configuration ios.sim.debug",
    "test:reuse": "detox test --reuse --configuration ios.sim.debug",
    "start-server": "cd ../backend && npm start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "metro:start": "cd ../front_end && npx expo start --clear &",
    "metro:wait": "node scripts/wait-for-metro.js",
    "metro:stop": "pkill -f 'expo start' || true",
    "e2e:android": "npm run metro:start && npm run metro:wait && npm run test:android; npm run metro:stop",
    "e2e:ios": "npm run metro:start && npm run metro:wait && npm run test:ios; npm run metro:stop",
    "e2e:auth:android": "npm run metro:start && npm run metro:wait && npm run test:auth:android; npm run metro:stop",
    "e2e:auth:ios": "npm run metro:start && npm run metro:wait && npm run test:auth; npm run metro:stop",
    "test:seller:android": "detox test e2e/seller --configuration android.emu.debug",
    "test:seller:ios": "detox test e2e/seller --configuration ios.sim.debug",
    "e2e:seller:android": "npm run metro:start && npm run metro:wait && npm run test:seller:android; npm run metro:stop",
    "e2e:seller:ios": "npm run metro:start && npm run metro:wait && npm run test:seller:ios; npm run metro:stop"
  },
  "keywords": [
    "detox",
    "e2e",
    "automation",
    "react-native",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "detox": "^20.13.0",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-typescript": "^7.21.0",
    "eslint": "^8.50.0"
  },
  "dependencies": {
    "axios": "^1.6.2"
  }
}
