<mxfile host="Electron" agent="Claude" version="28.2.5">
  <diagram name="Pipeline_v3" id="pipeline_v3">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ LEGEND ============ -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#x1f7e9; green = covered (Ch 5, 6, 14)&lt;br&gt;&#x1f7e8; amber = to be added&lt;br&gt;&#x2b1c; gray = system / I/O&lt;br&gt;&#x1f539; blue = action / state&lt;br&gt;&#x1f7ea; purple = principle / caveat&lt;br&gt;&lt;br&gt;Dashed border = cross-cutting overlay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="20" y="20" width="260" height="150" as="geometry" />
        </mxCell>

        <!-- ============ CHAPTER ROADMAP ============ -->
        <mxCell id="roadmap" value="&lt;b&gt;Completion order&lt;/b&gt;&lt;br&gt;to fill amber stages:&lt;br&gt;&lt;br&gt;1. Ch 3 &#x2014; Trends&lt;br&gt;2. Ch 4 &#x2014; Trading Ranges &amp; S/R&lt;br&gt;3. Ch 9 &#x2014; Stop-loss (essential)&lt;br&gt;4. Ch 11 &#x2014; Failed signals&lt;br&gt;5. Ch 10 &#x2014; Targets &amp; exits&lt;br&gt;6. Ch 8 &#x2014; Midtrend entry / pyramiding&lt;br&gt;7. Ch 16 &#x2014; Planned approach (sizing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="1120" y="20" width="260" height="200" as="geometry" />
        </mxCell>

        <!-- ============ ORACLE / PRINCIPLE NOTES (left side) ============ -->
        <mxCell id="note_osc" value="&lt;b&gt;Oscillator use (Ch 6)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#x2022; In TREND: advisory only.&#10;Divergence is alert, not entry.&lt;br&gt;&#x2022; In RANGE: actionable at&#10;range boundaries.&lt;br&gt;&#x2022; Always require price&#10;confirmation before acting." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="20" y="190" width="260" height="140" as="geometry" />
        </mxCell>

        <mxCell id="note_failed" value="&lt;b&gt;Failed-signal rule (Ch 11)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Schwager calls this the&#10;&lt;i&gt;most important rule&lt;/i&gt;.&lt;br&gt;&lt;br&gt;A failed breakout / failed&#10;pattern is often a stronger&#10;reversal signal than the&#10;original setup.&lt;br&gt;&lt;br&gt;Wired into BOTH branches:&#10;10L (trend) and 9R (range)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="20" y="350" width="260" height="200" as="geometry" />
        </mxCell>

        <!-- NEW: Regime classifier inputs box -->
        <mxCell id="regime_inputs" value="&lt;b&gt;Regime classifier inputs&lt;/b&gt;&lt;br&gt;(to be defined in Ch 3, 4)&lt;br&gt;&lt;br&gt;&#x2022; Long-MA slope (direction)&lt;br&gt;&#x2022; Swing high/low structure (Ch 3)&lt;br&gt;&#x2022; Range width relative to ATR&lt;br&gt;&#x2022; Trend strength (e.g., ADX)&lt;br&gt;&#x2022; Pattern context (Ch 5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="20" y="570" width="260" height="160" as="geometry" />
        </mxCell>

        <!-- ============ TOP PIPELINE ============ -->
