        <!-- Inputs box feeding regime (dashed leader) -->
        <mxCell id="e_inputs" style="endArrow=open;html=1;dashed=1;strokeColor=#d6b656;" parent="1" source="regime_inputs" target="s5_regime" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Regime to branches -->
        <mxCell id="e5L" value="trending" style="endArrow=classic;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="s5_regime" target="s6L_direction" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5R" value="range" style="endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="s5_regime" target="s6R_range" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Left branch internal edges -->
        <mxCell id="e6Lu" value="up" style="endArrow=classic;html=1;" parent="1" source="s6L_direction" target="s7L_up" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6Ld" value="down" style="endArrow=classic;html=1;" parent="1" source="s6L_direction" target="s7L_dn" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7Lu" style="endArrow=classic;html=1;" parent="1" source="s7L_up" target="s8L_signal" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7Ld" style="endArrow=classic;html=1;" parent="1" source="s7L_dn" target="s8L_signal" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8L" style="endArrow=classic;html=1;" parent="1" source="s8L_signal" target="s9L_filter" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9L" style="endArrow=classic;html=1;" parent="1" source="s9L_filter" target="s10L_failed" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Right branch internal edges -->
        <mxCell id="e6R" style="endArrow=classic;html=1;" parent="1" source="s6R_range" target="s7R_breakout" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7Ry" value="yes" style="endArrow=classic;html=1;" parent="1" source="s7R_breakout" target="s8R_confirm" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7Rn" value="no" style="endArrow=classic;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="s7R_breakout" target="s7R_hold" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8R" style="endArrow=classic;html=1;" parent="1" source="s8R_confirm" target="s9R_failed" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Branches → state machine -->
        <mxCell id="e_L_to_sm" value="signal" style="endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s10L_failed" target="state_flat" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_R_to_sm" value="signal" style="endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s9R_failed" target="state_flat" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ============ STATE MACHINE TRANSITIONS ============ -->
        <!-- FLAT → LONG -->
        <mxCell id="sm_f_to_l" value="buy signal" style="endArrow=classic;html=1;curved=1;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" parent="1" source="state_flat" target="state_long" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- LONG → FLAT -->
        <mxCell id="sm_l_to_f" value="exit / stop / target" style="endArrow=classic;html=1;curved=1;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" parent="1" source="state_long" target="state_flat" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- FLAT → SHORT -->
        <mxCell id="sm_f_to_s" value="sell signal" style="endArrow=classic;html=1;curved=1;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" parent="1" source="state_flat" target="state_short" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- SHORT → FLAT -->
        <mxCell id="sm_s_to_f" value="cover / stop / target" style="endArrow=classic;html=1;curved=1;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" parent="1" source="state_short" target="state_flat" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- State → action outputs -->
        <mxCell id="e_buy" style="endArrow=classic;html=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="state_flat" target="out_buy" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_sell" style="endArrow=classic;html=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="state_long" target="out_sell" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_sellshort" style="endArrow=classic;html=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="state_flat" target="out_sell_short" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_cover" style="endArrow=classic;html=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="state_short" target="out_cover" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_hold_l" style="endArrow=classic;html=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="state_long" target="out_hold" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_hold_s" style="endArrow=classic;html=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="state_short" target="out_hold" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_wait" style="endArrow=classic;html=1;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="state_flat" target="out_wait" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
