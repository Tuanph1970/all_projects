        <!-- ============ POSITION STATE MACHINE (NEW) ============ -->
        <mxCell id="sm_title" value="&lt;b&gt;Position state machine&lt;/b&gt;&lt;br&gt;Current state + incoming signal &#x2192; action.  Self-loops = pyramid (Ch 8, deferred)" style="text;html=1;align=center;fillColor=none;strokeColor=none;" parent="1" vertex="1">
