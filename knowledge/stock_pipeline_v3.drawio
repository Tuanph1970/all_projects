          <mxGeometry x="120" y="640" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s9L_filter" value="9L. &lt;b&gt;Filter + confirmation&lt;/b&gt; (Ch 14)&lt;br&gt;Direction filter, penetration, time delay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="120" y="720" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s10L_failed" value="10L. &lt;b&gt;Signal failed?&lt;/b&gt; (Ch 11)&lt;br&gt;If yes, consider reversing" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="120" y="800" width="280" height="80" as="geometry" />
        </mxCell>

        <!-- ============ RIGHT BRANCH: RANGE ============ -->
        <mxCell id="s6R_range" value="6R. &lt;b&gt;Trading range&lt;/b&gt; (Ch 4)&lt;br&gt;Locate support / resistance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="520" y="480" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s7R_breakout" value="7R. Breakout? (Ch 14)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="520" y="560" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s7R_hold" value="HOLD / wait for breakout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="830" y="580" width="170" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s8R_confirm" value="8R. &lt;b&gt;Confirm breakout direction&lt;/b&gt; (Ch 14)&lt;br&gt;Penetration + time delay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="520" y="660" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s9R_failed" value="9R. &lt;b&gt;Breakout failed?&lt;/b&gt; (Ch 11)&lt;br&gt;Bull / bear trap &#x2192; consider reversal" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="520" y="740" width="280" height="80" as="geometry" />
