        </mxCell>

        <!-- ============ RISK OVERLAY (EXPANDED) ============ -->
        <mxCell id="risk_container" value="&lt;b&gt;Risk overlay (cross-cutting)&lt;/b&gt;&lt;br&gt;Every entry / exit passes through these three modules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e0;strokeColor=#d6b656;dashed=1;align=center;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="990" y="240" width="380" height="850" as="geometry" />
        </mxCell>

        <mxCell id="risk_stops" value="&lt;b&gt;Stop-loss (Ch 9)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#x2022; Initial stop: ATR multiple&#10;or nearest swing low/high&lt;br&gt;&#x2022; Trailing stop: tighten on&#10;favorable moves&lt;br&gt;&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; stop_price&lt;br&gt;&#x2192; triggers exit when hit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="1010" y="300" width="340" height="170" as="geometry" />
        </mxCell>

        <mxCell id="risk_sizing" value="&lt;b&gt;Position sizing (Ch 16)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#x2022; Risk per trade (% equity)&lt;br&gt;&#x2022; ATR / volatility scaling&lt;br&gt;&#x2022; Adjust on drawdown&lt;br&gt;&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; position_size&lt;br&gt;&#x2192; applied at entry only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="1010" y="490" width="340" height="170" as="geometry" />
        </mxCell>

        <mxCell id="risk_targets" value="&lt;b&gt;Profit targets (Ch 10)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#x2022; Support / resistance level&lt;br&gt;&#x2022; Measured-move objective&lt;br&gt;&#x2022; Partial exits + trailing&#10;take-profit&lt;br&gt;&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; target_price&lt;br&gt;&#x2192; triggers exit when hit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="1010" y="680" width="340" height="170" as="geometry" />
        </mxCell>

        <mxCell id="risk_legend" value="&lt;i&gt;Legend for connectors:&lt;/i&gt;&lt;br&gt;&#x2014;&#x2014; sizing &#x2192; applied at entry&lt;br&gt;&#x2014;&#x2014; stop / target &#x2192; can fire exit&#10;in LONG or SHORT state" style="text;html=1;align=left;fillColor=none;strokeColor=none;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="1010" y="870" width="340" height="60" as="geometry" />
        </mxCell>

        <!-- ============ EDGES: top pipeline ============ -->
        <mxCell id="e1" style="endArrow=classic;html=1;" parent="1" source="s1_universe" target="s2_data" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;" parent="1" source="s2_data" target="s3_indicators" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell>
